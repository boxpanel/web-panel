        // -------- 雷达监控：3D与串口逻辑 --------
        function initRadarMonitor() {
            // 绑定按钮事件（只绑定一次）
            const connectBtn = document.getElementById('radar-connect');
            if (!connectBtn.dataset.bound) {
                connectBtn.addEventListener('click', connectSerial);
                document.getElementById('radar-disconnect').addEventListener('click', disconnectSerial);
                document.getElementById('clear-hex').addEventListener('click', () => {
                    const out = document.getElementById('radar-hex-output');
                    out.textContent = '';
                });
                const laneSelect = document.getElementById('lane-count');
                if (laneSelect) {
                    laneSelect.addEventListener('change', async () => {
                        radarLaneCount = parseInt(laneSelect.value, 10) || 4;
                        rebuildRoadScene();
                        await saveLaneSettings();
                    });
                }
                const laneWidthInput = document.getElementById('lane-width');
                if (laneWidthInput) {
                    laneWidthInput.addEventListener('change', async () => {
                        let v = parseFloat(laneWidthInput.value);
                        if (isNaN(v)) v = 6;
                        // 限制范围并按 0.1 米步进取整
                        v = Math.max(2, Math.min(12, v));
                        v = Math.round(v * 10) / 10;
                        laneWidthInput.value = v.toFixed(1);
                        radarLaneWidth = v;
                        rebuildRoadScene();
                        await saveLaneSettings();
                    });
                }

                // 初始化时从后端加载已保存的车道参数
                (async function loadLaneSettings() {
                    try {
                        const resp = await fetch('/api/radar/lane-settings');
                        if (resp.ok) {
                            const data = await resp.json();
                            if (laneSelect) {
                                laneSelect.value = String((data && data.laneCount) || 4);
                                radarLaneCount = parseInt(laneSelect.value, 10) || 4;
                            }
                            if (laneWidthInput) {
                                const w = (data && data.laneWidth) != null ? data.laneWidth : 6;
                                let v = parseFloat(w);
                                if (isNaN(v)) v = 6;
                                v = Math.max(2, Math.min(12, v));
                                v = Math.round(v * 10) / 10;
                                laneWidthInput.value = v.toFixed(1);
                                radarLaneWidth = v;
                            }
                            rebuildRoadScene();
                            try { updateLaneWidthIndicator(); } catch (_) {}
                        }
                    } catch (e) {
                        console.warn('加载车道参数失败:', e);
                    }
                })();

                // 保存车道设置到后端
                async function saveLaneSettings() {
                    try {
                        const resp = await fetch('/api/radar/lane-settings', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ laneCount: radarLaneCount, laneWidth: radarLaneWidth })
                        });
                        if (resp.ok) {
                            try { showNotification('success', '车道参数已保存'); } catch (_) {}
                            try { updateLaneWidthIndicator(); } catch (_) {}
                        } else {
                            let errMsg = '车道参数保存失败';
                            try { const j = await resp.json(); if (j && j.error) errMsg = j.error; } catch (_) {}
                            try { showNotification('error', errMsg); } catch (_) {}
                        }
                    } catch (error) {
                        try { showNotification('error', '车道参数保存失败'); } catch (_) {}
                        console.error('保存车道参数失败:', error);
                    }
                }
                const fovSlider = document.getElementById('camera-fov');
                const fovValue = document.getElementById('camera-fov-value');
                if (fovSlider) {
                    const applyFov = (val) => {
                        const fov = parseInt(val, 10) || 60;
                        if (radarCamera3D) {
                            radarCamera3D.fov = fov;
                            radarCamera3D.updateProjectionMatrix();
                        }
                        if (fovValue) fovValue.textContent = String(fov);
                    };
                    fovSlider.addEventListener('input', () => applyFov(fovSlider.value));
                    fovSlider.addEventListener('change', () => applyFov(fovSlider.value));
                }
                const refreshBtn = document.getElementById('refresh-ports');
                if (refreshBtn) {
                    refreshBtn.addEventListener('click', () => {
                        scanSerialPorts();
                    });
                }
                // 初始化时自动扫描
                scanSerialPorts();
                connectBtn.dataset.bound = 'true';
            }

            // 初始化3D场景（如果尚未初始化）
            if (!radarRenderer) {
                initRadar3D();
            }
        }

        function initRadar3D() {
            const container = document.getElementById('radar-3d-container');
            const canvas = document.getElementById('radarCanvas');

            if (!container || !canvas) {
                console.error('雷达3D容器或画布不存在，初始化中止');
                return;
            }

            const width = container.clientWidth || 800;
            const height = Math.max(400, container.clientHeight || 400);

            try {
                radarRenderer = new THREE.WebGLRenderer({ canvas, antialias: true });
            } catch (e) {
                console.error('WebGLRenderer 初始化失败:', e);
                return;
            }
            radarRenderer.setSize(width, height);
            radarRenderer.setPixelRatio(window.devicePixelRatio);
            radarRenderer.setClearColor(0x0b132b, 1);

            radarScene = new THREE.Scene();
            
            radarCamera3D = new THREE.PerspectiveCamera(60, width / height, 0.1, 1000);
            radarCamera3D.position.set(0, 60, 120);
            radarCamera3D.lookAt(0, 0, 0);

            // OrbitControls 交互
            if (THREE.OrbitControls) {
                radarControls = new THREE.OrbitControls(radarCamera3D, radarRenderer.domElement);
                radarControls.enableDamping = true;
                radarControls.dampingFactor = 0.05;
                radarControls.target.set(0, 0, 0);
                radarControls.update();
            }

            // 初始FOV来自面板值
            // 面板已移除FOV控件，保持默认初始FOV=60。

            rebuildRoadScene();

            // 光源
            radarScene.add(new THREE.AmbientLight(0x888888));
            const dirLight = new THREE.DirectionalLight(0xffffff, 0.6);
            dirLight.position.set(50, 100, 50);
            radarScene.add(dirLight);

            // 使用鼠标滚轮调整：默认调整相机FOV；按住Shift滚轮调整车道宽度
            try {
                const container = document.getElementById('radar-3d-container');
                const wheelTarget = radarRenderer?.domElement || container;
                wheelTarget.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    const delta = Math.sign(e.deltaY);
                    if (e.shiftKey) {
                        let v = (radarLaneWidth || 6) - delta * 0.2;
                        v = Math.max(2, Math.min(12, v));
                        radarLaneWidth = parseFloat(v.toFixed(1));
                        try { rebuildRoadScene(); } catch (_) {}
                        try { saveLaneSettings(); } catch (_) {}
                        try { updateLaneWidthIndicator(); } catch (_) {}
                    } else if (radarCamera3D) {
                        let f = (radarCamera3D.fov || 60) - delta * 2;
                        f = Math.max(30, Math.min(90, f));
                        radarCamera3D.fov = f;
                        radarCamera3D.updateProjectionMatrix();
                    }
                }, { passive: false });
            } catch (_) {}

            // 调整大小事件
            window.addEventListener('resize', () => {
                const w = container.clientWidth;
                const h = Math.max(400, container.clientHeight);
                radarCamera3D.aspect = w / h;
                radarCamera3D.updateProjectionMatrix();
                radarRenderer.setSize(w, h);
            });

            // 开始动画
            startRadarAnimation();

            // 页面可见性切换时暂停/恢复动画，避免重复循环导致卡顿
            if (!radarVisibilityBound) {
                document.addEventListener('visibilitychange', () => {
                    if (document.hidden) {
                        stopRadarAnimation();
                    } else {
                        // 仅在渲染器已初始化时恢复
                        if (radarRenderer && !radarAnimating) {
                            startRadarAnimation();
                        }
                    }
                });
                window.addEventListener('beforeunload', () => {
                    cleanupRadar3D();
                });
                // 兼容某些浏览器在页面切换时触发的 pagehide 事件
                window.addEventListener('pagehide', () => {
                    cleanupRadar3D();
                });
                radarVisibilityBound = true;
            }

            // 监听容器的可见性（例如切换页面的显示/隐藏），可见时恢复动画并重置渲染尺寸
            try {
                const isElementVisible = (el) => !!(el && el.offsetParent !== null);
                const resumeIfVisible = () => {
                    if (!container) return;
                    if (isElementVisible(container)) {
                        const w = container.clientWidth || 800;
                        const h = Math.max(400, container.clientHeight || 400);
                        if (radarCamera3D && radarRenderer) {
                            radarCamera3D.aspect = w / h;
                            radarCamera3D.updateProjectionMatrix();
                            radarRenderer.setSize(w, h);
                        }
                        if (radarRenderer && !radarAnimating) startRadarAnimation();
                    } else {
                        stopRadarAnimation();
                    }
                };
                // 首次尝试
                resumeIfVisible();
                // 使用 IntersectionObserver 更稳健地检测显示/隐藏
                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) resumeIfVisible();
                            else stopRadarAnimation();
                        });
                    }, { root: null, threshold: 0.1 });
                    io.observe(container);
                } else {
                    // 退化方案：定时器轮询容器可见性
                    setInterval(resumeIfVisible, 1000);
                }
            } catch (e) {
                console.warn('可见性监听初始化失败:', e);
            }
        }

        function startRadarAnimation() {
            // 防止重复启动动画循环
            if (radarAnimating && radarAnimationId !== null) return;
            radarAnimating = true;
            const placeholder = document.getElementById('radar-3d-placeholder');
            if (placeholder) placeholder.style.display = 'none';
            const animate = () => {
                if (!radarAnimating) return;
                // 车辆沿道路前进
                if (radarVehicle) {
                    radarVehicle.position.x += 0.5;
                    if (radarVehicle.position.x > radarRoadLength / 2) {
                        radarVehicle.position.x = -radarRoadLength / 2;
                    }
                }
                if (radarControls) radarControls.update();
                radarRenderer.render(radarScene, radarCamera3D);
                radarAnimationId = requestAnimationFrame(animate);
            };
            // 立即渲染一帧，并开始循环
            radarAnimationId = requestAnimationFrame(animate);
        }

        function updateLaneWidthIndicator() {
            const el = document.getElementById('lane-width-indicator');
            if (el) {
                const v = (radarLaneWidth != null ? radarLaneWidth : 6);
                try { el.textContent = `车道宽度: ${parseFloat(v).toFixed(1)} m`; } catch (_) {}
            }
        }

        function rebuildRoadScene() {
            // 清理旧道路
            if (radarRoadGroup) {
                radarScene.remove(radarRoadGroup);
                radarRoadGroup.traverse(obj => {
                    if (obj.geometry) obj.geometry.dispose();
                    if (obj.material) {
                        if (Array.isArray(obj.material)) obj.material.forEach(m => m.dispose());
                        else obj.material.dispose();
                    }
                });
            }
            radarRoadGroup = new THREE.Group();

            const laneWidth = radarLaneWidth || 6; // 每车道宽度（单位）
            const shoulder = 2;   // 边线缓冲
            const roadLength = radarRoadLength;
            const roadWidth = radarLaneCount * laneWidth + shoulder * 2;

            // 路面
            const roadGeom = new THREE.PlaneGeometry(roadLength, roadWidth);
            const texLoader = new THREE.TextureLoader();
            // 使用噪声法线贴图模拟沥青粗糙度
            const asphaltNormal = texLoader.load('https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/textures/perlin-512.png');
            asphaltNormal.wrapS = asphaltNormal.wrapT = THREE.RepeatWrapping;
            const repeatX = Math.max(1, Math.floor(roadLength / 50));
            const repeatY = Math.max(1, Math.floor(roadWidth / 10));
            asphaltNormal.repeat.set(repeatX, repeatY);
            const roadMat = new THREE.MeshStandardMaterial({
                color: 0x3a3a3a, // 沥青深灰色
                normalMap: asphaltNormal,
                normalScale: new THREE.Vector2(0.2, 0.2),
                roughness: 1.0,
                metalness: 0.0
            });
            const road = new THREE.Mesh(roadGeom, roadMat);
            road.rotation.x = -Math.PI / 2;
            radarRoadGroup.add(road);

            // 左右边线
            const edgeMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.3, metalness: 0.0 });
            const edgeGeom = new THREE.PlaneGeometry(roadLength, 0.6);
            const leftEdge = new THREE.Mesh(edgeGeom, edgeMat);
            leftEdge.rotation.x = -Math.PI / 2;
            leftEdge.position.set(0, 0.01, -roadWidth / 2 + 0.6);
            const rightEdge = leftEdge.clone();
            rightEdge.position.set(0, 0.01, roadWidth / 2 - 0.6);
            radarRoadGroup.add(leftEdge);
            radarRoadGroup.add(rightEdge);

            // 车道分隔虚线（每个车道边界）
            for (let i = 1; i < radarLaneCount; i++) {
                const z = -roadWidth / 2 + shoulder + i * laneWidth;
                const lineGeom = new THREE.BufferGeometry().setFromPoints([
                    new THREE.Vector3(-roadLength / 2, 0.02, z),
                    new THREE.Vector3(roadLength / 2, 0.02, z),
                ]);
                const lineMat = new THREE.LineDashedMaterial({
                    color: 0xeeeeee,
                    dashSize: 4,
                    gapSize: 3,
                });
                const dashedLine = new THREE.Line(lineGeom, lineMat);
                dashedLine.computeLineDistances();
                radarRoadGroup.add(dashedLine);
            }

            // 车辆示例（置于靠近左侧第一车道）
            const vehicleGeom = new THREE.BoxGeometry(3, 2, 2);
            // 周边配色改为灰白色，去除深蓝色
            const vehicleMat = new THREE.MeshPhongMaterial({ color: 0xdedede });
            radarVehicle = new THREE.Mesh(vehicleGeom, vehicleMat);
            radarVehicle.position.set(-roadLength / 2 + 10, 1, -roadWidth / 2 + shoulder + laneWidth / 2);
            radarRoadGroup.add(radarVehicle);

            radarScene.add(radarRoadGroup);
            try { updateLaneWidthIndicator(); } catch (_) {}
        }

        function stopRadarAnimation() {
            radarAnimating = false;
            if (radarAnimationId !== null) {
                try { cancelAnimationFrame(radarAnimationId); } catch (_) {}
                radarAnimationId = null;
            }
        }

        // 在完全离开雷达页面时，彻底释放 WebGL 资源与控制器，防止内存泄漏与上下文占用
        function cleanupRadar3D() {
            try { stopRadarAnimation(); } catch (_) {}
            try {
                if (radarControls) {
                    radarControls.dispose();
                    radarControls = null;
                }
            } catch (_) {}
            try {
                if (radarRenderer) {
                    // three.js r128: dispose 会清理相关资源；如需更强制，也可考虑 forceContextLoss()
                    if (typeof radarRenderer.forceContextLoss === 'function') {
                        try { radarRenderer.forceContextLoss(); } catch (_) {}
                    }
                    radarRenderer.dispose();
                    radarRenderer = null;
                }
            } catch (_) {}
            try {
                if (radarScene) {
                    radarScene.traverse(obj => {
                        try {
                            if (obj.geometry) obj.geometry.dispose();
                            if (obj.material) {
                                if (Array.isArray(obj.material)) obj.material.forEach(m => { try { m.dispose(); } catch (_) {} });
                                else obj.material.dispose();
                            }
                            if (obj.texture) { try { obj.texture.dispose(); } catch (_) {} }
                        } catch (_) {}
                    });
                }
            } catch (_) {}
            radarScene = null;
            radarRoadGroup = null;
            radarVehicle = null;
            radarCamera3D = null;
            const canvas = document.getElementById('radarCanvas');
            if (canvas) {
                // 清空画布尺寸，帮助浏览器尽快回收图形上下文
                try { canvas.width = 0; canvas.height = 0; } catch (_) {}
            }
        }

        // 改为调用后端：扫描并列出可用串口设备
        async function scanSerialPorts() {
            try {
                const resp = await fetch('/api/serial/ports', { method: 'GET', headers: { 'Accept': 'application/json' } });
                if (!resp.ok) {
                    if (resp.status === 401 || resp.status === 403) {
                        showErrorAlert('未登录或会话过期，请先登录');
                        try { window.location.href = '/login'; } catch (_) {}
                        return;
                    }
                    throw new Error('HTTP错误: ' + resp.status);
                }
                let data;
                const ct = resp.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    data = await resp.json();
                } else {
                    showErrorAlert('接口返回非JSON内容，可能未登录');
                    try { window.location.href = '/login'; } catch (_) {}
                    return;
                }
                if (!data.success) throw new Error(data.message || '扫描失败');
                const ports = data.ports || [];
                const select = document.getElementById('authorized-ports');
                if (select) {
                    select.innerHTML = '';
                    if (!ports.length) {
                        const opt = document.createElement('option');
                        opt.value = '';
                        opt.textContent = '未发现串口设备';
                        select.appendChild(opt);
                    } else {
                        ports.forEach((p, idx) => {
                            const opt = document.createElement('option');
                            opt.value = p.path || p.comName || String(idx);
                            const vid = p.vendorId || '未知VID';
                            const pid = p.productId || '未知PID';
                            const label = `${p.path || '设备'} (VID: ${vid}, PID: ${pid})`;
                            opt.textContent = label;
                            select.appendChild(opt);
                        });
                    }
                }
            } catch (err) {
                console.error('扫描串口失败:', err);
                showErrorAlert('扫描串口失败: ' + (err && err.message ? err.message : '未知错误'));
            }
        }

        // 使用纯 Socket.IO
        async function connectSerial() {
            const out = document.getElementById('radar-hex-output');
            try {
                const baudRate = parseInt(document.getElementById('radar-baud-rate').value, 10);
                const authSelect = document.getElementById('authorized-ports');
                const path = authSelect && authSelect.value ? authSelect.value : '';
                if (!path) {
                    showErrorAlert('请选择一个串口设备');
                    return;
                }

                function updateStatus(connected) {
                    document.getElementById('radar-conn-status').className = connected ? 'badge bg-success' : 'badge bg-secondary';
                    document.getElementById('radar-conn-status').textContent = connected ? '已连接' : '未连接';
                    document.getElementById('radar-connect').disabled = connected;
                    document.getElementById('radar-disconnect').disabled = !connected;
                    // 保持3D动画与串口连接状态解耦，不在此处停止或启动动画
                }

                function handleMessage(msg) {
                    try {
                        const obj = typeof msg === 'string' ? JSON.parse(msg) : (typeof msg === 'object' ? msg : {});
                        if (obj.type === 'data' && obj.data) {
                            out.textContent += obj.data + '\n';
                            out.scrollTop = out.scrollHeight;
                        } else if (obj.type === 'status') {
                            updateStatus(!!obj.open);
                        } else if (obj.type === 'error') {
                            showErrorAlert('串口错误: ' + (obj.error || '未知错误'));
                        }
                    } catch (_) {}
                }

                if (!window.io) {
                    showErrorAlert('缺少 Socket.IO 客户端脚本');
                    return;
                }

                try { window.radarSerialIO?.disconnect?.(); } catch (_) {}
                const socket = window.io('/serial', {
                    path: '/socket.io',
                    // 允许回退到 polling，避免环境不支持原生 WebSocket 时失败
                    withCredentials: true,
                    reconnection: true,
                    reconnectionAttempts: 5,
                    reconnectionDelay: 1000,
                    timeout: 8000
                });
                window.radarSerialIO = socket;
                socket.on('connect', () => {
                    const openOpts = {
                        dataBits: 8,
                        stopBits: 1,
                        parity: 'none',
                        xon: false,
                        xoff: false,
                        xany: false,
                        rtscts: false,
                        highWaterMark: 1024
                    };
                    try { socket.emit('open', { path, baudRate, ...openOpts }); } catch (e) {}
                });
                socket.on('message', handleMessage);
                socket.on('connect_error', (e) => {
                    console.warn('Socket.IO 连接错误:', e && e.message);
                    showErrorAlert('Socket.IO 连接失败: ' + (e && e.message ? e.message : '未知错误'));
                });
                socket.on('disconnect', () => {
                    console.log('Socket.IO 已断开');
                    updateStatus(false);
                });
            } catch (err) {
                console.error('串口连接失败:', err);
                showErrorAlert('串口连接失败: ' + (err && err.message ? err.message : '未知错误'));
                disconnectSerial();
            }
        }

        async function disconnectSerial() {
            try {
                const ioSock = window.radarSerialIO;
                if (ioSock && ioSock.connected) {
                    try { ioSock.emit('close'); } catch (_) {}
                    try { ioSock.disconnect(); } catch (_) {}
                }
            } finally {
                try { window.radarSerialIO?.disconnect?.(); } catch (_) {}
                document.getElementById('radar-conn-status').className = 'badge bg-secondary';
                document.getElementById('radar-conn-status').textContent = '未连接';
                document.getElementById('radar-connect').disabled = false;
                document.getElementById('radar-disconnect').disabled = true;
                // 保持3D动画继续运行，避免断开后交互卡顿
            }
        }

        // 通过WebSocket写入串口数据示例：
        // 假设存在一个文本输入 id="radar-serial-input" 与发送按钮 id="radar-serial-send"
        const sendBtn = document.getElementById('radar-serial-send');
        const sendInput = document.getElementById('radar-serial-input');
        if (sendBtn && sendInput) {
            sendBtn.addEventListener('click', () => {
                const text = sendInput.value || '';
                if (!text) return;
                const ioSock = window.radarSerialIO;
                if (!ioSock || !ioSock.connected) {
                    showErrorAlert('未连接串口');
                    return;
                }
                try { ioSock.emit('write', { data: text, hex: false }); } catch (e) { showErrorAlert('发送失败: ' + e.message); }
            });
        }

    </script>



