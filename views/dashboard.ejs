        async function discoverOnvifDevices() {
            const button = document.getElementById('discover-onvif');
            const originalHtml = button ? button.innerHTML : '';
            try {
                if (button) {
                    button.disabled = true;
                    button.innerHTML = '<i class="bi bi-search"></i> 搜索中...';
                }

                addCameraLogToUI('info', '开始搜索ONVIF设备...');

                const username = document.getElementById('camera-username')?.value || '';
                const password = document.getElementById('camera-password')?.value || '';

                const response = await fetch('/api/camera/onvif/discover', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });

                if (response.status === 401) {
                    window.location.href = '/login';
                    return;
                }

                const data = await response.json();
                if (!data.success) {
                    addCameraLogToUI('error', data.error || '搜索ONVIF设备失败');
                    return;
                }

                const devices = Array.isArray(data.devices) ? data.devices : [];
                const devicesWithRtsp = devices.filter(d => d && typeof d.rtspUri === 'string' && d.rtspUri.startsWith('rtsp://'));
                onvifRtspMap = new Map();
                for (const d of devicesWithRtsp) {
                    const masked = maskRtspForDisplay(d.rtspUri);
                    if (masked) onvifRtspMap.set(masked, d.rtspUri);
                }

                await refreshCameraLogs();
            } catch (error) {
                console.error('搜索ONVIF设备失败:', error);
                addCameraLogToUI('error', '搜索ONVIF设备失败: ' + error.message);
            } finally {
                if (button) {
                    button.disabled = false;
                    button.innerHTML = originalHtml;
                }
            }
        }

        function maskRtspForDisplay(rtspUri) {
            try {
                if (!rtspUri || !rtspUri.startsWith('rtsp://')) return rtspUri;
                const withoutScheme = rtspUri.slice('rtsp://'.length);
                const atIndex = withoutScheme.indexOf('@');
                if (atIndex === -1) return rtspUri;
                const cred = withoutScheme.slice(0, atIndex);
                const rest = withoutScheme.slice(atIndex + 1);
                const colonIndex = cred.indexOf(':');
                if (colonIndex === -1) return `rtsp://${cred}@${rest}`;
                const user = cred.slice(0, colonIndex);
                return `rtsp://${user}:***@${rest}`;
            } catch (e) {
                return rtspUri;
            }
        }

        function applyRtspToCameraSettings(rtspUri) {
            try {
                if (!rtspUri || !rtspUri.startsWith('rtsp://')) {
                    addCameraLogToUI('warn', 'RTSP地址无效，无法应用');
                    return;
                }

                const urlObj = new URL(rtspUri);
                const ip = urlObj.hostname || '';
                const port = urlObj.port || '554';
                const path = (urlObj.pathname || '/') + (urlObj.search || '');

                if (!ip) {
                    addCameraLogToUI('warn', 'RTSP地址中未解析到IP/域名');
                    return;
                }

                const ipInput = document.getElementById('camera-ip');
                const portInput = document.getElementById('camera-port');
                const pathSelect = document.getElementById('rtsp-path-select');
                const customInput = document.getElementById('stream-url');

                if (ipInput) ipInput.value = ip;
                if (portInput) portInput.value = port;

                if (pathSelect && customInput) {
                    let foundOption = false;
                    for (let option of pathSelect.options) {
                        if (option.value === path) {
                            pathSelect.value = path;
                            customInput.style.display = 'none';
                            customInput.value = path;
                            foundOption = true;
                            break;
                        }
                    }

                    if (!foundOption) {
                        pathSelect.value = 'custom';
                        customInput.value = path;
                        customInput.style.display = 'block';
                    }
                }

                addCameraLogToUI('info', '已将RTSP解析结果填入摄像头设置');
            } catch (error) {
                console.error('应用RTSP到摄像头设置失败:', error);
                addCameraLogToUI('error', '应用RTSP到摄像头设置失败: ' + error.message);
            }
        }
        

        
