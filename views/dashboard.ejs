        // 为特定接口保存网络设置
        async function saveNetworkSettingsForInterface(interfaceName) {
            // 获取IP模式
            const ipMode = document.querySelector(`input[name="ip-mode-${interfaceName}"]:checked`).value;
            
            const config = {
                interfaceName: interfaceName,
                ipMode: ipMode
            };
            
            // 获取DNS设置
            const dnsInput = document.getElementById(`dns-${interfaceName}`);
            if (dnsInput && dnsInput.value.trim()) {
                const dnsServers = dnsInput.value.split(',').map(dns => dns.trim()).filter(dns => dns);
                if (dnsServers.length > 0) {
                    config.primaryDNS = dnsServers[0];
                    if (dnsServers.length > 1) {
                        config.secondaryDNS = dnsServers[1];
                    }
                }
            }
            
            // 如果是静态IP模式，获取静态IP配置
            if (ipMode === 'static') {
                const staticIP = document.getElementById(`static-ip-${interfaceName}`).value;
                const subnetMask = document.getElementById(`subnet-mask-${interfaceName}`).value;
                const gateway = document.getElementById(`gateway-${interfaceName}`).value;
                
                config.staticIP = staticIP;
                config.subnetMask = subnetMask;
                config.gateway = gateway;
            }
            
            // 使用新的验证机制
            const validationErrors = validateNetworkConfig(config);
            if (validationErrors.length > 0) {
                // 显示验证错误
                const errorContainer = document.getElementById(`validation-errors-${interfaceName}`) || 
                    (() => {
                        const container = document.createElement('div');
                        container.id = `validation-errors-${interfaceName}`;
                        const modalBody = document.querySelector('#networkSettingsModal .modal-body');
                        if (modalBody) {
                            modalBody.insertBefore(container, modalBody.firstChild);
                        }
                        return container;
                    })();
                
                showValidationErrors(validationErrors, `validation-errors-${interfaceName}`);
                return;
            }
            
            // 清除之前的错误信息
            const errorContainer = document.getElementById(`validation-errors-${interfaceName}`);
            if (errorContainer) {
                errorContainer.style.display = 'none';
            }
            
            // 直接应用设置，无需确认弹窗
            
            // 发送配置到服务器
            fetch('/api/network-interface-config', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(config)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // 检查是否设置了静态IP
                    if (config.ipMode === 'static' && config.staticIP) {
                        // 设置了静态IP，显示提示并重定向到新IP
                        const targetIP = config.staticIP;
                        showSuccessAlert('静态IP设置成功！页面将在3秒后自动跳转到新的IP地址: ' + targetIP);
                        
                        // 关闭模态框
                        const modal = bootstrap.Modal.getInstance(document.getElementById('networkSettingsModal'));
                        modal.hide();
                        
                        // 3秒后重定向到新IP
                        setTimeout(() => {
                            const currentProtocol = window.location.protocol;
                            const currentPort = window.location.port;
                            let newUrl = currentProtocol + '//' + targetIP;
                            
                            // 如果当前有端口号，保持端口号
                            if (currentPort && currentPort !== '80' && currentPort !== '443') {
                                newUrl += ':' + currentPort;
                            }
                            
                            // 保持当前路径
                            newUrl += window.location.pathname + window.location.search + window.location.hash;
                            
                            console.log('重定向到新IP:', newUrl);
                            window.location.href = newUrl;
                        }, 3000);
                    } else if (data.ipChanged && data.newIP) {
                        // IP发生了变更（其他情况），显示提示并重定向到新IP
                        showSuccessAlert('网络设置保存成功！页面将在3秒后自动跳转到新的IP地址: ' + data.newIP);
                        
                        // 关闭模态框
                        const modal = bootstrap.Modal.getInstance(document.getElementById('networkSettingsModal'));
                        modal.hide();
                        
                        // 3秒后重定向到新IP
                        setTimeout(() => {
                            const currentProtocol = window.location.protocol;
                            const currentPort = window.location.port;
                            let newUrl = currentProtocol + '//' + data.newIP;
                            
                            // 如果当前有端口号，保持端口号
                            if (currentPort && currentPort !== '80' && currentPort !== '443') {
                                newUrl += ':' + currentPort;
                            }
                            
                            // 保持当前路径
                            newUrl += window.location.pathname + window.location.search + window.location.hash;
                            
                            console.log('重定向到新IP:', newUrl);
                            window.location.href = newUrl;
                        }, 3000);
                    } else {
                        // 没有IP变更，正常处理
                        if (data.warning) {
                            showWarningAlert(data.message || data.warning);
                        } else {
                            showSuccessAlert(data.message || '网络设置已应用！');
                        }
                        // 关闭模态框
                        const modal = bootstrap.Modal.getInstance(document.getElementById('networkSettingsModal'));
                        modal.hide();
                        // 刷新网络信息
                        setTimeout(() => {
                            loadNetworkInfo();
                        }, data.warning ? 3000 : 1000);
                    }
                } else {
                    showErrorAlert('应用网络设置失败: ' + (data.error || '未知错误'));
                }
            })
            .catch(error => {
                console.error('保存网络设置失败:', error);
                showErrorAlert('保存网络设置失败，请检查网络连接。');
            });
        }
        
        // 获取当前系统IP地址并填充到静态IP输入框
        function loadCurrentSystemIP() {
            fetch('/api/network-interfaces')
                .then(response => {
                    if (response.status === 401) {
                        // 会话已过期，重定向到登录页面
                        window.location.href = '/login';
                        return;
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data) return; // 如果已重定向，data为undefined
                    if (data.interfaces && data.interfaces.length > 0) {
                        // 找到第一个有IP地址且状态为up的接口
                        const activeInterface = data.interfaces.find(iface => iface.ip && iface.operstate === 'up') || 
                                               data.interfaces.find(iface => iface.ip);
                        
                        // 如果找到有IP的接口，自动填充到静态IP输入框
                        if (activeInterface && activeInterface.ip) {
                            document.getElementById('static-ip').value = activeInterface.ip;
                        }
                    }
                })
                .catch(error => {
                    console.error('获取系统IP地址失败:', error);
                });
        }
        

        
