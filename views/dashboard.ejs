                                                    <p class="text-muted mt-3">点击下方按钮开启摄像头</p>
                                                </div>
                                                <video id="camera-video" style="display: none; width: 100%; min-height: 500px; max-height: 80vh; object-fit: contain; border-radius: 10px;" autoplay muted></video>
                                            </div>
                                            <div class="mt-3">
                                                <button id="discover-onvif" class="btn btn-primary me-2">
                                                    <i class="bi bi-search"></i> 搜索
                                                </button>
                                                <button id="start-camera" class="btn btn-success me-2">
                                                    <i class="bi bi-play-circle"></i> 开启
                                                </button>
                                                <button id="stop-camera" class="btn btn-danger me-2" style="display: none;">
                                                    <i class="bi bi-stop-circle"></i> 关闭
                                                </button>
                                            </div>
                                        </div>
                                    </div>
