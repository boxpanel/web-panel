                                                        <span class="badge bg-${iface.ipMode === 'dhcp' ? 'success' : 'warning'} bg-opacity-10 text-${iface.ipMode === 'dhcp' ? 'success' : 'warning'} small">
                                                            ${iface.ipMode === 'dhcp' ? '自动获取' : '静态IP'}
                                                        </span>
                                                        ${bridgeStatusBadge}
                                                    </div>
                                                </div>
                                            </div>
                                            <span class="badge bg-${iface.status === 'up' ? 'success' : 'secondary'} fs-6">
                                                ${iface.status === 'up' ? '已连接' : '未连接'}
                                            </span>
                                        </div>
                                        
                                        ${isBridged ? `
                                        <div class="alert alert-warning alert-sm mb-3" style="font-size: 0.85rem; padding: 8px 12px;">
                                            <i class="bi bi-info-circle me-1"></i>
                                            此接口已被桥接使用，无法编辑配置
                                        </div>
                                        ` : ''}
                                        
                                        <!-- 操作按钮 -->
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-outline-primary btn-sm flex-fill" 
                                                    onclick="showNetworkSettings('${iface.name}')"
                                                    ${buttonDisabled}>
                                                <i class="bi bi-gear me-1"></i>设置
                                            </button>
                                            <button class="btn btn-outline-info btn-sm flex-fill" 
                                                    onclick="showNetworkDetails('${iface.name}')">
                                                <i class="bi bi-info-circle me-1"></i>详情
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        }).join('');
                        // 使用Bootstrap的row类包装卡片
                        interfacesContainer.innerHTML = `<div class="row">${interfacesContainer.innerHTML}</div>`;
                        
                        // 功能状态更新已移除
                    } else {
                        interfacesContainer.innerHTML = `
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-wifi-off display-1 text-muted mb-3"></i>
                                <h6>无网络接口信息</h6>
                                <p class="small">请检查网络连接或刷新页面</p>
                            </div>
                        `;
                    }
                    

                })
                .catch(error => {
                    console.error('加载网络信息失败:', error);
                    const networkCardsElement = document.getElementById('network-interfaces-cards');
                    if (networkCardsElement && document.contains(networkCardsElement)) {
                        networkCardsElement.innerHTML = `
                        <div class="text-center text-danger py-5">
