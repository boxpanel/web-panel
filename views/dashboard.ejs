        // 加载目录内容
        function loadDirectory(path, addToHistoryFlag = true) {
            // 显示加载中提示
            const fileListElement = document.getElementById('file-list');
            if (!fileListElement) {
                console.error('file-list元素未找到，可能页面未完全加载或已切换');
                return;
            }
            
            // 检查元素是否仍然在DOM中
            if (!document.contains(fileListElement)) {
                console.error('file-list元素已从DOM中移除');
                return;
            }
            
            fileListElement.innerHTML = '<tr><td colspan="5" class="text-center">加载中...</td></tr>';
            
            // 调用API获取文件列表
            fetch(`/api/files?path=${encodeURIComponent(path)}`, {
                credentials: 'same-origin'
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(errorData => {
                            throw new Error(errorData.error || `HTTP ${response.status}: ${response.statusText}`);
                        }).catch(() => {
                            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                        });
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.error) {
                        throw new Error(data.error);
                    }
                    
                    // 再次检查DOM元素是否存在
                    const fileListElement = document.getElementById('file-list');
                    if (!fileListElement || !document.contains(fileListElement)) {
                        console.log('页面已切换，取消文件列表渲染');
                        return;
                    }
                    
                    currentPath = data.path;
                    
                    // 更新路径输入框的值
                    const pathInput = document.getElementById('current-path-input');
                    if (pathInput) {
                        pathInput.value = currentPath;
                    }
                    
                    if (addToHistoryFlag) {
                        addToHistory(currentPath);
                    }
                    updatePathBreadcrumb(currentPath);
                    renderFileList(data.files);
                })
                .catch(error => {
                    console.error('获取文件列表失败:', error);
                    const errorMessage = error.message || '未知错误';
                    const fileListElement = document.getElementById('file-list');
                    if (!fileListElement || !document.contains(fileListElement)) {
                        console.log('页面已切换，取消错误信息显示');
                        return;
                    }
                    fileListElement.innerHTML = 
                        `<tr><td colspan="5" class="text-center text-danger">
                            <div class="mb-2">
                                <i class="bi bi-exclamation-triangle"></i> 获取文件列表失败
                            </div>
                            <div class="small text-muted">${errorMessage}</div>
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-primary" onclick="loadDirectory('${path.replace(/'/g, "\\'")}')">重试</button>
                                <button class="btn btn-sm btn-outline-secondary" onclick="initFileManager()">返回首页</button>
                            </div>
                        </td></tr>`;
                });
        }
        
        // 更新路径导航
        function updatePathBreadcrumb(path) {
            const breadcrumb = document.querySelector('.breadcrumb');
            const pathInput = document.getElementById('current-path-input');
            
            // 检查breadcrumb元素是否存在
            if (!breadcrumb || !document.contains(breadcrumb)) {
                console.log('页面已切换，取消路径导航更新');
                return;
            }
            
            // 更新路径输入框
        if (pathInput) {
            pathInput.value = path;
            // 确保路径输入框有键盘事件监听
            if (!pathInput.hasAttribute('data-listener-added')) {
                pathInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const newPath = this.value.trim();
                        if (newPath && newPath !== currentPath) {
                            if (isValidPath(newPath)) {
                                loadDirectory(newPath);
                            } else {
                                showErrorAlert('路径格式不正确，请检查后重试');
                                this.focus();
                                this.select();
                            }
                        }
                    }
                });
                pathInput.setAttribute('data-listener-added', 'true');
            }
        }
            
            // 清空现有内容
            breadcrumb.innerHTML = '';
            
            // 检测路径类型
            const isWindows = path.includes('\\') || path.match(/^[A-Z]:\\/);
            const separator = isWindows ? '\\' : '/';
            
            const parts = path.split(/[\\\/]/).filter(part => part);
            
            if (isWindows) {
                // Windows路径处理
                const drive = parts.length > 0 ? parts[0] : 'C:';
                breadcrumb.innerHTML += `<li class="breadcrumb-item"><a href="#" onclick="navigateToPath('${drive}\\')" style="text-decoration: none;">${drive}\\</a></li>`;
                
                let pathSoFar = drive;
                for(let index = 1; index < parts.length; index++) {
                    const part = parts[index];
                    pathSoFar += '\\' + part;
                    if (index === parts.length - 1) {
                        breadcrumb.innerHTML += `<li class="breadcrumb-item active">${part}</li>`;
                    } else {
                        breadcrumb.innerHTML += `<li class="breadcrumb-item"><a href="#" onclick="navigateToPath('${pathSoFar.replace(/\\/g, '\\\\')}\\\\'')">${part}</a></li>`;
                    }
                }
            } else {
                // Linux路径处理
                breadcrumb.innerHTML += `<li class="breadcrumb-item"><a href="#" onclick="navigateToPath('/')" style="text-decoration: none;">/</a></li>`;
                
                let pathSoFar = '';
                for(let index = 0; index < parts.length; index++) {
                    const part = parts[index];
                    pathSoFar += '/' + part;
                    if (index === parts.length - 1) {
                        breadcrumb.innerHTML += `<li class="breadcrumb-item active">${part}</li>`;
                    } else {
                        breadcrumb.innerHTML += `<li class="breadcrumb-item"><a href="#" onclick="navigateToPath('${pathSoFar}')">${part}</a></li>`;
                    }
                }
            }
        }
        
        // 渲染文件列表
        function renderFileList(files) {
            const fileList = document.getElementById('file-list');
            if (!fileList || !document.contains(fileList)) {
                console.log('页面已切换，取消文件列表渲染');
                return;
            }
            fileList.innerHTML = '';
            
            files.forEach(file => {
                const row = document.createElement('tr');
                
                // 根据文件类型设置图标和样式
                let iconClass, iconType;
                if (file.type === 'folder') {
                    iconClass = 'bi-folder-fill';
                    iconType = 'folder';
                } else {
                    const ext = file.name.split('.').pop().toLowerCase();
                    if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'svg', 'webp'].includes(ext)) {
                        iconClass = 'bi-image';
                        iconType = 'image';
                    } else if (['mp4', 'avi', 'mkv', 'mov', 'wmv', 'flv', 'webm'].includes(ext)) {
                        iconClass = 'bi-camera-video';
                        iconType = 'video';
                    } else if (['zip', 'rar', '7z', 'tar', 'gz', 'bz2'].includes(ext)) {
                        iconClass = 'bi-archive';
                        iconType = 'archive';
                    } else {
                        iconClass = 'bi-file-earmark';
                        iconType = 'file';
                    }
                }
                
                row.setAttribute('data-filename', file.name);
                row.innerHTML = `
                    <td class="select-column">
                        <input type="checkbox" class="form-check-input file-checkbox" value="${file.name}" data-filename="${file.name}" onchange="updateBatchOperations()">
                    </td>
                    <td>
                        <div class="file-name" onclick="${file.type === 'folder' ? `openFolder('${file.name}')` : `openFile('${file.name}')`}">
                            <i class="bi ${iconClass} file-icon ${iconType}"></i>
                            <span>${file.name}</span>
                        </div>
                    </td>
                    <td class="file-date">${file.modified}</td>
                    <td class="permissions-column">${file.permissions || '-'}</td>
                    <td class="owner-column">${file.owner || '-'}</td>
                    <td class="group-column">${file.group || '-'}</td>
                    <td class="file-size">${file.size}</td>
                    <td class="action-column">
                        <div class="file-actions text-actions">
                            <button class="btn btn-link btn-sm text-primary" onclick="${file.type === 'folder' ? `openFolder('${file.name}')` : `openFile('${file.name}')`}" title="打开">打开</button>
                            <button class="btn btn-link btn-sm text-success" onclick="downloadFile('${file.name}')" title="下载">下载</button>
                            <button class="btn btn-link btn-sm text-warning" onclick="extractFile('${file.name}')" title="解压" ${(() => {
                                const ext = file.name.split('.').pop().toLowerCase();
                                const supportedFormats = ['zip', 'rar', '7z', 'tar', 'gz', 'bz2'];
                                return supportedFormats.includes(ext) ? '' : 'disabled style="opacity: 0.5; cursor: not-allowed;"';
                            })()}>解压</button>
                            <div class="dropdown d-inline">
                                <button class="btn btn-link btn-sm text-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="更多操作">更多</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="#" onclick="editPermissions('${file.name}')"><i class="bi bi-shield-lock me-2"></i>编辑权限</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="compressFile('${file.name}')"><i class="bi bi-file-zip me-2"></i>压缩</a></li>
                                    <li><hr class="dropdown-divider"></li>
