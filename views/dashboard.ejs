            beautifulConfirm(`确定要解压文件 "${fileName}" 吗？`, '解压确认')
                .then(confirmed => {
                    if (confirmed) {
                        // 显示加载状态
                        beautifulAlert('正在解压文件，请稍候...', 'info', '解压中');
                        
                        // 调用后端API进行解压
                        fetch('/api/files/extract', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                path: currentPath,
                                fileName: fileName
                            })
                        })
                        .then(response => response.json())
                        .then(result => {
                            if (result.success) {
                                beautifulAlert('文件解压成功！', 'success', '操作成功');
