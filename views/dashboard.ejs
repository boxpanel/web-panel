        <!-- 网络监控内容 -->
        <div id="network-content" class="content-section" style="display: none;">
            <!-- 网络概览 -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0" style="color: white;">
                                    <i class="bi bi-router me-2" style="color: white;"></i>
                                    网络接口管理
                                </h5>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success btn-sm" onclick="showCreateBridge()">
                                        <i class="bi bi-plus-circle me-1"></i>创建桥接
                                    </button>
                                    <button class="btn btn-info btn-sm" onclick="showBridgeList()">
                                        <i class="bi bi-list-ul me-1"></i>查看桥接
                                    </button>
                                    <button class="btn btn-light btn-sm" onclick="refreshNetworkInterfaces()">
                                        <i class="bi bi-arrow-clockwise me-1"></i>刷新
                                    </button>
                                </div>
                            </div>
