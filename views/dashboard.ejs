                                     <i class="bi bi-box-arrow-right me-2"></i>退出登录
                                 </button>
                             </form>
                         </li>
                     </ul>
                 </div>
             </div>
         </div>
     </nav>

    <!-- 主内容区域 -->
    <div class="main-content">
        <div class="container-fluid mt-4">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- 仪表板内容 -->
        <div id="dashboard-content" class="content-section">
            <!-- 系统状态卡片 -->
        <div class="row mb-4">
            <% if (systemInfo) { %>
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="card fnos-card monitor-card" style="position: relative;">
                        <div class="card-body text-center">
                            <div class="circular-progress progress-info" id="cpuProgress">
                                <svg>
                                    <circle class="progress-bg" cx="50" cy="50" r="35"></circle>
                                    <circle class="progress-bar" cx="50" cy="50" r="35" id="cpuProgressBar"></circle>
                                </svg>
                                <div class="progress-text">
                                    <div class="progress-value" id="cpuUsage"><%= systemInfo.cpuLoad %>%</div>
                                </div>
                            </div>
                            <div class="extra-content"></div>
                            <h6 class="card-title text-white">CPU使用率</h6>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="card fnos-card-info monitor-card" style="position: relative;">
                        <div class="card-body text-center">
                            <div class="circular-progress progress-info" id="memoryProgress">
                                <svg>
                                    <circle class="progress-bg" cx="50" cy="50" r="35"></circle>
                                    <circle class="progress-bar" cx="50" cy="50" r="35" id="memoryProgressBar"></circle>
                                </svg>
                                <div class="progress-text">
                                    <div class="progress-value" id="memoryUsage"><%= systemInfo.memory.usage || 0 %>%</div>

                                </div>
                            </div>
                            <% const memTotalBrief = ((systemInfo.memory && systemInfo.memory.total) ? systemInfo.memory.total : 0) / 1024; const memUsedRaw = (systemInfo.memory && typeof systemInfo.memory.used !== 'undefined') ? systemInfo.memory.used : (((systemInfo.memory && systemInfo.memory.total) ? systemInfo.memory.total : 0) - ((systemInfo.memory && typeof systemInfo.memory.free !== 'undefined') ? systemInfo.memory.free : 0)); const memUsedBrief = memUsedRaw / 1024; %>
                            <div class="extra-content">
                                <div class="small text-white d-flex flex-column gap-1 brief-lines">
                                    <div>内存: <span id="memoryTotalBrief"><%= memTotalBrief.toFixed(2) %></span> <small>GB</small></div>
                                    <div>使用: <span id="memoryUsedBrief"><%= memUsedBrief.toFixed(2) %></span> <small>GB</small></div>
                                </div>
                            </div>
                            <h6 class="card-title text-white">内存使用率</h6>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="card fnos-card-warning monitor-card" style="position: relative;">
                        <div class="card-body text-center">
                            <div class="circular-progress progress-warning" id="diskProgress">
                                <svg>
                                    <circle class="progress-bg" cx="50" cy="50" r="35"></circle>
                                    <circle class="progress-bar" cx="50" cy="50" r="35" id="diskProgressBar"></circle>
                                </svg>
                                <div class="progress-text">
                                    <div class="progress-value" id="diskUsage">
                                        <% if (systemInfo.disk && systemInfo.disk.length > 0) { 
                                            const _diskUsage = (typeof systemInfo.disk[0].usage !== 'undefined') ? systemInfo.disk[0].usage : systemInfo.disk[0].usePercent;
                                        %>
                                            <%= _diskUsage %>%
                                        <% } else { %>
                                            N/A
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <% const sumRawSizeBrief = (systemInfo.disk || []).reduce((sum, d) => sum + (d.size || 0), 0); const sumRawAvailBrief = (systemInfo.disk || []).reduce((sum, d) => sum + (d.available || 0), 0); const isBytesBrief = sumRawSizeBrief > 100000; const diskTotalSizeBrief = isBytesBrief ? (sumRawSizeBrief / 1024 / 1024 / 1024) : sumRawSizeBrief; const diskFreeBrief = isBytesBrief ? (sumRawAvailBrief / 1024 / 1024 / 1024) : sumRawAvailBrief; %>
                            <div class="extra-content">
                                <div class="small text-white d-flex flex-column gap-1 brief-lines">
                                      <div>容量: <span id="diskTotalCapacityBrief"><%= diskTotalSizeBrief.toFixed(2) %></span> <small>GB</small></div>
                                      <div>剩余: <span id="diskFreeSpaceBrief"><%= diskFreeBrief.toFixed(2) %></span> <small>GB</small></div>
                                  </div>
                            </div>
                            <h6 class="card-title text-white">磁盘使用率</h6>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="card fnos-card-danger monitor-card" style="position: relative;">
                        <div class="card-body text-center">
                            <div class="circular-progress progress-danger" id="uptimeProgress">
                                <svg>
                                    <circle class="progress-bg" cx="50" cy="50" r="35"></circle>
                                    <circle class="progress-bar" cx="50" cy="50" r="35" id="uptimeProgressBar" style="stroke-dashoffset: 70;"></circle>
                                </svg>
                                <div class="progress-text">
                                    <div class="progress-value" id="systemUptime"><%= systemInfo.os.uptime %></div>
                                </div>
                            </div>
                            <div class="extra-content"></div>
                            <h6 class="card-title text-white">系统运行时间</h6>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="col-12">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        无法获取系统信息，请检查系统权限或稍后重试。
                    </div>
                </div>
            <% } %>
        </div>

        <div class="row">
            <!-- 资源使用图表 -->
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-graph-up me-2"></i>
                            资源使用情况
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="resourceChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        </div>
        
        <!-- 系统信息内容 -->
        <div id="system-info-content" class="content-section" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                详细系统信息
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- 错误信息显示 -->
                            <div id="systemInfoError" class="alert alert-danger" style="display: none;"></div>
                            <% if (systemInfo) { %>
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6 class="text-primary">操作系统信息</h6>
                                        <table class="table table-sm" style="font-size: 1rem;">
                            <tr><td><strong>操作系统:</strong></td><td><%= systemInfo.os.distro %> <%= systemInfo.os.release %></td></tr>
                            <tr><td><strong>内核版本:</strong></td><td><%= systemInfo.os.kernel %></td></tr>
                            <tr><td><strong>架构:</strong></td><td><%= systemInfo.os.arch %></td></tr>
                            <tr><td><strong>主机名:</strong></td><td><%= systemInfo.os.hostname %></td></tr>
                            <tr><td><strong>运行时间:</strong></td><td><%= systemInfo.os.uptime %></td></tr>
                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="text-primary">硬件信息</h6>
                                        <table class="table table-sm" style="font-size: 1rem;">
                            <tr><td><strong>CPU:</strong></td><td><%= systemInfo.cpu.brand %></td></tr>
                            <tr><td><strong>CPU核心:</strong></td><td><%= systemInfo.cpu.cores %>核</td></tr>
                            <tr><td><strong>CPU频率:</strong></td><td><%= systemInfo.cpu.speed %> GHz</td></tr>
                            <tr><td><strong>NPU算力:</strong></td><td>
                                <span class="badge" style="background-color: <%= systemInfo.cpu.npuTier.color %>; color: white;">
                                    <%= systemInfo.cpu.npu %>
                                </span>
                                <small class="text-muted ms-1">(<%= systemInfo.cpu.npuTier.label %>)</small>
                            </td></tr>
                            <% if (systemInfo.cpu.aiCapable) { %>
                            <tr><td><strong>AI支持格式:</strong></td><td><%= systemInfo.cpu.supportFormats %></td></tr>
                            <% } %>
                            <tr><td><strong>总内存:</strong></td><td><%= (systemInfo.memory.total / 1024).toFixed(2) %> <small>GB</small></td></tr>
                            <tr><td><strong>可用内存:</strong></td><td><%= (systemInfo.memory.free / 1024).toFixed(2) %> <small>GB</small></td></tr>
                            <% const sumRawSize = (systemInfo.disk || []).reduce((sum, d) => sum + (d.size || 0), 0); const sumRawAvail = (systemInfo.disk || []).reduce((sum, d) => sum + (d.available || 0), 0); const isBytes = sumRawSize > 100000; const diskTotalSize = isBytes ? (sumRawSize / 1024 / 1024 / 1024) : sumRawSize; const diskFree = isBytes ? (sumRawAvail / 1024 / 1024 / 1024) : sumRawAvail; %>
                            <tr><td><strong>硬盘总容量:</strong></td><td><span id="diskTotalCapacity"><%= diskTotalSize.toFixed(2) %></span> <small>GB</small></td></tr>
                            <tr><td><strong>硬盘剩余空间:</strong></td><td><span id="diskFreeSpace"><%= diskFree.toFixed(2) %></span> <small>GB</small></td></tr>
                        </table>
                                    </div>
                                </div>
                            <% } else { %>
                                <p class="text-muted">系统信息加载失败</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 摄像头内容 -->
        <div id="camera-content" class="content-section" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header text-white" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);">
