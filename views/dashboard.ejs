        // 加载网络接口设置
        function loadNetworkInterfaceSettings(interfaceName) {
            return fetch(`/api/network-interface-settings?interface=${encodeURIComponent(interfaceName)}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('网络请求失败');
                    }
                    return response.json();
                })
                .then(settings => {
                    // 将设置存储到全局变量中，供模态框使用
                    window.currentInterfaceSettings = settings;
                    return settings;
                });
        }
        

         
         // 绑定网络设置到表单
         function bindNetworkSettingsToForm(interfaceName) {
             const settings = window.currentInterfaceSettings;
             if (!settings) return;
             
             // 设置IP模式
             const ipModeRadio = document.querySelector(`input[name="ip-mode-${interfaceName}"][value="${settings.ipMode}"]`);
             if (ipModeRadio) {
                 ipModeRadio.checked = true;
                 // 触发IP模式选择事件
                 selectIPMode(interfaceName, settings.ipMode);
             }
             
             // 如果是静态IP模式，填充静态IP设置
             if (settings.ipMode === 'static') {
                 const staticIPInput = document.getElementById(`static-ip-${interfaceName}`);
                 const subnetMaskSelect = document.getElementById(`subnet-mask-${interfaceName}`);
                 const gatewayInput = document.getElementById(`gateway-${interfaceName}`);
                 
                 if (staticIPInput && settings.staticIP) {
                     staticIPInput.value = settings.staticIP;
                 }
                 if (subnetMaskSelect && settings.subnetMask) {
                     subnetMaskSelect.value = settings.subnetMask;
                 }
                 if (gatewayInput && settings.gateway) {
                     gatewayInput.value = settings.gateway;
                 }
             }
             
             // 设置DNS
             const dnsInput = document.getElementById(`dns-${interfaceName}`);
             if (dnsInput) {
                 if (settings.primaryDNS || settings.secondaryDNS) {
                     const dnsServers = [];
                     if (settings.primaryDNS) dnsServers.push(settings.primaryDNS);
                     if (settings.secondaryDNS) dnsServers.push(settings.secondaryDNS);
                     dnsInput.value = dnsServers.join(', ');
                 }
             }
         }
        
