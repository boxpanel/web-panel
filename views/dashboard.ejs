                        <i class="bi bi-camera-video" style="font-size: 3rem; color: #007bff;"></i>
                        <h6 class="mt-3">正在连接摄像头</h6>
                        <div class="mt-3">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">连接中...</span>
                            </div>
                            <span class="ms-2">正在建立WebRTC连接...</span>
                        </div>
                    </div>
                `;
                
                // 保存摄像头配置到数据库
                await saveCameraConfig();
                const mtxResponse = await fetch('/api/camera/mediamtx/stream', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({})
                });
                
                if (mtxResponse.status === 401) {
                    window.location.href = '/login';
                    return;
                }
                
                if (!mtxResponse.ok) {
                    const errText = await mtxResponse.text();
                    let parsed = null;
                    try {
                        parsed = JSON.parse(errText);
                    } catch (e) {
                    }
                    if (parsed) {
                        addCameraLogToUI('error', `MediaMTX推流失败: ${parsed.error || `HTTP ${mtxResponse.status}`}`);
                        if (parsed.details) {
                            addCameraLogToUI('warn', `失败详情: ${parsed.details}`);
                        }
                        if (parsed.stderrTail && Array.isArray(parsed.stderrTail) && parsed.stderrTail.length) {
                            addCameraLogToUI('warn', `推流stderr尾部: ${parsed.stderrTail.join(' | ')}`);
                        }
                    }
                    throw new Error((parsed && parsed.error) ? parsed.error : (errText || `MediaMTX推流失败 (HTTP ${mtxResponse.status})`));
                }
                
                const mtxData = await mtxResponse.json();
                const whepUrl = mtxData.whepUrl;
                addCameraLogToUI('info', `将通过MediaMTX WebRTC播放: ${whepUrl}`);
                if (mtxData.path) {
                    try {
                        const pathsResp = await fetch(`/api/camera/mediamtx/paths?path=${encodeURIComponent(mtxData.path)}`);
                        if (pathsResp.ok) {
                            const pathsData = await pathsResp.json();
                            const item = pathsData && Array.isArray(pathsData.items) ? pathsData.items[0] : null;
                            if (item) {
                                addCameraLogToUI('info', `MediaMTX路径状态: ${item.name} ready=${Boolean(item.ready)} readers=${Array.isArray(item.readers) ? item.readers.length : 0}`);
                            } else {
                                addCameraLogToUI('warn', `MediaMTX未找到路径: ${mtxData.path}`);
                            }
                        } else {
                            const txt = await pathsResp.text();
                            addCameraLogToUI('warn', `读取MediaMTX路径状态失败: HTTP ${pathsResp.status} ${txt || ''}`.trim());
                        }
                    } catch (e) {
                        addCameraLogToUI('warn', `读取MediaMTX路径状态异常: ${e && e.message ? e.message : 'unknown'}`);
                    }
                }
                
                // 在创建新的video元素前，先清理已存在的webrtc-video元素，防止重复创建
                const container = document.getElementById('camera-container');
                const existingWebrtcVideo = container.querySelector('#webrtc-video');
                if (existingWebrtcVideo) {
                    // 移除事件监听器
                    if (existingWebrtcVideo._resizeHandler) {
                        window.removeEventListener('resize', existingWebrtcVideo._resizeHandler);
                        existingWebrtcVideo._resizeHandler = null;
                    }
                    // 移除元素
                    existingWebrtcVideo.remove();
                }
                
                // 创建video元素用于WebRTC播放
                const videoElement = document.createElement('video');
                videoElement.id = 'webrtc-video';
                videoElement.autoplay = true;
                videoElement.muted = true;
                videoElement.playsInline = true;
                videoElement.controls = true;
                videoElement.style.width = '100%';
                videoElement.style.height = 'auto';
                videoElement.style.minHeight = 'auto';
                videoElement.style.maxHeight = 'none';
                videoElement.style.objectFit = 'contain';
                videoElement.style.maxWidth = '100%';
                videoElement.style.borderRadius = '10px';
                videoElement.style.backgroundColor = '#000';
                videoElement.style.display = 'block';
                
                // 隐藏占位符并显示video元素
                // container已在上面定义
                
                // 隐藏占位符
                if (placeholder) {
                    placeholder.style.display = 'none';
                }
                
                // 设置容器样式以适应视频
                container.style.alignItems = 'center';
                container.style.justifyContent = 'center';
                container.style.padding = '10px';
                container.style.minHeight = 'auto';
                container.style.maxHeight = 'none';
                container.style.height = 'auto';
                container.style.overflow = 'hidden';
                container.style.resize = 'both';
                
                // 监听视频尺寸变化，动态调整容器
                videoElement.addEventListener('loadedmetadata', function() {
                    const aspectRatio = this.videoWidth / this.videoHeight;
                    const containerWidth = container.offsetWidth - 20; // 减去padding
                    const calculatedHeight = containerWidth / aspectRatio;
                    
                    // 设置视频元素尺寸
                    this.style.width = '100%';
                    this.style.height = 'auto';
                    this.style.maxWidth = '100%';
                    
                    // 动态调整容器高度
                    container.style.height = calculatedHeight + 20 + 'px'; // 加上padding
                });
                
                // 监听窗口大小变化，重新计算容器尺寸
                const resizeHandler = function() {
                    if (videoElement.videoWidth && videoElement.videoHeight) {
                        const aspectRatio = videoElement.videoWidth / videoElement.videoHeight;
                        const containerWidth = container.offsetWidth - 20;
                        const calculatedHeight = containerWidth / aspectRatio;
                        container.style.height = calculatedHeight + 20 + 'px';
                    }
                };
                window.addEventListener('resize', resizeHandler);
                
                // 将事件处理器存储到video元素上，以便后续移除
                videoElement._resizeHandler = resizeHandler;
                
                // 添加video元素
                container.appendChild(videoElement);
                
                // 创建WebRTC连接
                rtspPlayer = new RTCPeerConnection({
                    iceServers: [{
                        urls: ["stun:stun.l.google.com:19302"]
                    }]
                });

                const logRtcState = (level, label, value) => {
                    addCameraLogToUI(level, `WebRTC ${label}: ${value}`);
                };

                rtspPlayer.oniceconnectionstatechange = () => {
                    const state = rtspPlayer.iceConnectionState;
                    logRtcState(state === 'failed' || state === 'disconnected' ? 'warn' : 'info', 'ICE状态', state);
                };
                rtspPlayer.onconnectionstatechange = () => {
                    const state = rtspPlayer.connectionState;
                    logRtcState(state === 'failed' || state === 'disconnected' ? 'warn' : 'info', '连接状态', state);
                };
                rtspPlayer.onsignalingstatechange = () => {
                    logRtcState('info', '信令状态', rtspPlayer.signalingState);
                };
                rtspPlayer.onicegatheringstatechange = () => {
                    logRtcState('info', 'ICE收集状态', rtspPlayer.iceGatheringState);
                };
                rtspPlayer.onicecandidateerror = (event) => {
                    logRtcState('warn', 'ICE候选错误', `${event.errorCode || ''} ${event.errorText || ''}`.trim() || 'unknown');
                };
                
                // 处理远程流
                rtspPlayer.ontrack = function(event) {
                    console.log('收到远程视频流');
                    addCameraLogToUI('info', `收到远程媒体轨道: ${event.track ? event.track.kind : 'unknown'}`);
                    const remoteStream = (event.streams && event.streams[0]) ? event.streams[0] : new MediaStream([event.track]);
                    videoElement.srcObject = remoteStream;
                    videoElement.play().catch(() => {});
                };

                let firstFrameReceived = false;
                let firstFrameTimeout = null;
                const markFirstFrame = (reason) => {
                    if (firstFrameReceived) return;
                    firstFrameReceived = true;
                    if (firstFrameTimeout) {
                        clearTimeout(firstFrameTimeout);
                        firstFrameTimeout = null;
                    }
                    addCameraLogToUI('info', `已收到视频帧(${reason})`);
                };

                videoElement.addEventListener('loadeddata', () => {
                    addCameraLogToUI('info', '视频事件: loadeddata');
                    markFirstFrame('loadeddata');
                });
                videoElement.addEventListener('playing', () => {
                    addCameraLogToUI('info', '视频事件: playing');
                    markFirstFrame('playing');
                });
                videoElement.addEventListener('stalled', () => addCameraLogToUI('warn', '视频事件: stalled'));
                videoElement.addEventListener('error', () => addCameraLogToUI('error', '视频事件: error'));
                
                // 添加收发器
                rtspPlayer.addTransceiver('video', {
                    'direction': 'recvonly'
                });
                
                // 创建数据通道
                const sendChannel = rtspPlayer.createDataChannel('foo');
                sendChannel.onopen = () => {
                    console.log('数据通道已打开');
                    sendChannel.send('ping');
                    setInterval(() => {
                        if (sendChannel.readyState === 'open') {
                            sendChannel.send('ping');
                        }
                    }, 1000);
                };
                
                // 创建SDP offer
                const webrtcStartAt = Date.now();
                const offer = await rtspPlayer.createOffer();
                await rtspPlayer.setLocalDescription(offer);
                addCameraLogToUI('info', 'WebRTC本地Offer已创建');

                const waitIceGatheringComplete = async (pc, timeoutMs = 10000) => {
                    if (pc.iceGatheringState === 'complete') return true;
                    return new Promise(resolve => {
                        const timer = setTimeout(() => {
                            pc.removeEventListener('icegatheringstatechange', onState);
                            resolve(false);
                        }, timeoutMs);
                        const onState = () => {
                            if (pc.iceGatheringState === 'complete') {
                                clearTimeout(timer);
                                pc.removeEventListener('icegatheringstatechange', onState);
                                resolve(true);
                            }
                        };
                        pc.addEventListener('icegatheringstatechange', onState);
                    });
                };

                const gathered = await waitIceGatheringComplete(rtspPlayer, 2500);
                if (!gathered) {
                    addCameraLogToUI('warn', 'ICE候选收集超时，将继续尝试协商');
                }
                addCameraLogToUI('info', `ICE候选收集阶段结束，用时${Math.floor((Date.now() - webrtcStartAt) / 10) / 100}s`);

                const whepStartAt = Date.now();
                let whepResponse = null;
                let lastWhepErrorText = '';
                while (Date.now() - whepStartAt < 20000) {
                    try {
                        whepResponse = await fetch(whepUrl, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/sdp'
                            },
                            body: rtspPlayer.localDescription.sdp
                        });
                    } catch (e) {
                        const msg = e && e.message ? String(e.message) : '';
                        lastWhepErrorText = msg || 'Failed to fetch';
                        addCameraLogToUI('warn', `WHEP请求失败(${lastWhepErrorText})，重试中...`);
                        await new Promise(r => setTimeout(r, 700));
                        continue;
                    }

                    if (whepResponse.ok) break;

                    lastWhepErrorText = await whepResponse.text();
                    if (whepResponse.status === 404 || whepResponse.status === 409 || whepResponse.status === 503) {
                        addCameraLogToUI('warn', `WHEP尚未就绪(HTTP ${whepResponse.status})，等待推流中...`);
                        await new Promise(r => setTimeout(r, 700));
                        continue;
                    }
                    throw new Error(`WHEP协商失败: ${whepResponse.status} - ${lastWhepErrorText}`);
                }

                if (!whepResponse || !whepResponse.ok) {
                    throw new Error(`WHEP等待超时(20s): ${lastWhepErrorText || '推流仍未就绪'}`);
                }

                const answerSdp = await whepResponse.text();
                await rtspPlayer.setRemoteDescription(new RTCSessionDescription({
                    type: 'answer',
                    sdp: answerSdp
                }));
                addCameraLogToUI('info', 'WHEP远端Answer已设置');

                const startWaitAt = Date.now();
                firstFrameTimeout = setTimeout(() => {
                    const hasAnyProgress = firstFrameReceived ||
                        (videoElement.videoWidth > 0 && videoElement.videoHeight > 0) ||
                        (videoElement.readyState >= 2) ||
                        (videoElement.currentTime > 0);
                    if (hasAnyProgress) return;
                    addCameraLogToUI(
                        'warn',
                        `超过20秒尚未开始播放（readyState=${videoElement.readyState}，currentTime=${videoElement.currentTime.toFixed(3)}，video=${videoElement.videoWidth}x${videoElement.videoHeight}，ICE=${rtspPlayer.iceConnectionState}，conn=${rtspPlayer.connectionState}），将继续等待...`
                    );
                }, 20000);
                
                // 更新按钮状态
                document.getElementById('start-camera').style.display = 'none';
                document.getElementById('stop-camera').style.display = 'inline-block';
                
                // 获取选择的AI模型
                const selectedModel = document.getElementById('model-select').value;
                // 移除成功提示框，用户不需要看到连接成功的弹窗
                // const alertMessage = selectedModel ? 
                //     `摄像头连接成功，正在使用 ${selectedModel} 模型处理视频流` : 
                //     '摄像头连接成功，WebRTC流播放已启动';
                // showSuccessAlert(alertMessage);
                console.log('WebRTC流播放已启动');
                if (selectedModel) {
                    console.log('AI模型处理已启用:', selectedModel);
                }
                
            } catch (error) {
                console.error('启动摄像头失败:', error);
                
                // 将错误信息添加到摄像头连接日志，而不是显示在视频容器内
                const errorMessage = error.message || '未知错误';
                addCameraLogToUI('error', `摄像头连接失败: ${errorMessage}`);
                
                // 恢复到初始状态，只显示视频插件容器，不显示任何错误提示
                const video = document.getElementById('camera-video');
                const placeholder = document.getElementById('camera-placeholder');
                const container = document.getElementById('camera-container');
                
                if (video) {
                    video.style.display = 'none';
                    video.srcObject = null;
                }
                
                // 移除任何动态创建的video元素，包括webrtc-video
                if (container) {
                    const dynamicVideos = container.querySelectorAll('video:not(#camera-video)');
                    dynamicVideos.forEach(v => {
                        // 移除事件监听器
                        if (v._resizeHandler) {
                            window.removeEventListener('resize', v._resizeHandler);
                            v._resizeHandler = null;
                        }
                        v.remove();
                    });
                    
                    // 特别处理webrtc-video元素
                    const webrtcVideo = container.querySelector('#webrtc-video');
                    if (webrtcVideo) {
                        if (webrtcVideo._resizeHandler) {
                            window.removeEventListener('resize', webrtcVideo._resizeHandler);
                            webrtcVideo._resizeHandler = null;
                        }
                        webrtcVideo.remove();
                    }
                    
                    // 恢复容器原始样式
                    container.style.alignItems = 'center';
                    container.style.justifyContent = 'center';
                    container.style.padding = '';
                }
                
                // 恢复初始placeholder，只保留视频插件，不显示错误信息
                if (placeholder) {
                    placeholder.innerHTML = `
                        <i class="bi bi-camera-video" style="font-size: 4rem; color: #6c757d;"></i>
                        <p class="text-muted mt-3">点击下方按钮开启摄像头</p>
                    `;
                    placeholder.style.display = 'block';
                }
                
                // 恢复按钮状态
                document.getElementById('start-camera').style.display = 'inline-block';
                document.getElementById('stop-camera').style.display = 'none';
                
                // 不再抛出错误，避免显示额外的错误提示
                return;
            }
        }
        
        // 动态加载rtsp-relay脚本
        function loadRtspScript(scriptUrl) {
            return new Promise((resolve, reject) => {
                const script = document.getElementById('rtsp-relay-script');
                script.src = scriptUrl;
                script.onload = () => {
                    // 脚本加载完成后，loadPlayer函数应该可用
                    if (window.loadPlayer) {
                        loadPlayer = window.loadPlayer;
                        resolve();
                    } else {
                        reject(new Error('rtsp-relay脚本加载失败'));
                    }
                };
                script.onerror = () => {
                    reject(new Error('无法加载rtsp-relay脚本'));
                };
            });
        }
        
        // 停止摄像头 (WebRTC)
        function stopCamera() {
            try {
                fetch('/api/camera/mediamtx/stop', { method: 'POST' }).catch(() => {});
            } catch (e) {
            }
            // 停止WebRTC连接
            if (rtspPlayer) {
                try {
                    rtspPlayer.close();
                } catch (error) {
                    console.log('停止WebRTC连接时出错:', error);
                }
                rtspPlayer = null;
            }
            
            // 停止传统视频流（兼容性）
            if (currentStream) {
                currentStream.getTracks().forEach(track => track.stop());
                currentStream = null;
            }
            
            const video = document.getElementById('camera-video');
            const placeholder = document.getElementById('camera-placeholder');
            const container = document.getElementById('camera-container');
            
            // 移除动态添加的video元素并恢复占位符
            if (container) {
                // 移除所有动态添加的video元素
                const dynamicVideos = container.querySelectorAll('video:not(#camera-video)');
                dynamicVideos.forEach(video => video.remove());
                
                // 恢复容器原始样式
                container.style.alignItems = 'center';
                container.style.justifyContent = 'center';
                container.style.padding = '';
                container.style.height = 'auto';
                container.style.minHeight = '300px';
                container.style.maxHeight = 'none';
                container.style.resize = 'none';
                
                // 移除视频相关的事件监听器并删除webrtc-video元素
                const existingVideo = container.querySelector('#webrtc-video');
                if (existingVideo) {
                    // 移除窗口resize事件监听器
                    if (existingVideo._resizeHandler) {
                        window.removeEventListener('resize', existingVideo._resizeHandler);
                        existingVideo._resizeHandler = null;
                    }
                    // 移除webrtc-video元素
                    existingVideo.remove();
                }
                
                // 显示占位符并重置内容
                const placeholder = document.getElementById('camera-placeholder');
                if (placeholder) {
                    placeholder.style.display = 'block';
                    // 重置占位符内容为初始状态
                    placeholder.innerHTML = `
                        <div class="text-center">
                            <i class="bi bi-camera-video" style="font-size: 4rem; color: #6c757d;"></i>
                            <p class="text-muted mt-3">点击下方按钮开启摄像头</p>
                        </div>
                    `;
                } else {
                    // 如果占位符不存在，重新创建
                    container.innerHTML = `
                        <div id="camera-placeholder">
                            <i class="bi bi-camera-video" style="font-size: 4rem; color: #6c757d;"></i>
                            <p class="text-muted mt-3">点击下方按钮开启摄像头</p>
                        </div>
                        <video id="camera-video" style="display: none; width: 100%; min-height: 500px; max-height: 80vh; object-fit: contain; border-radius: 10px;" autoplay muted></video>
                    `;
                }
            } else {
                // 兼容旧版本布局
                if (video) video.style.display = 'none';
                if (placeholder) {
                    placeholder.style.display = 'block';
                    // 重置占位符内容为初始状态
                    placeholder.innerHTML = `
                        <div class="text-center">
                            <i class="bi bi-camera-video" style="font-size: 4rem; color: #6c757d;"></i>
                            <p class="text-muted mt-3">点击下方按钮开启摄像头</p>
                        </div>
                    `;
                }
            }
            
            // 更新按钮状态
            document.getElementById('start-camera').style.display = 'inline-block';
            document.getElementById('stop-camera').style.display = 'none';
            
            // 移除停止成功提示框，用户不需要看到停止成功的弹窗
            // showSuccessAlert('摄像头已停止');
        }
        

        
        // 摄像头日志相关函数
        let cameraLogInterval;
        let renderedCameraLogKeys = new Set();
        
        function buildCameraLogKey(log) {
            const ts = log && log.timestamp ? String(log.timestamp) : '';
            const lvl = log && log.level ? String(log.level) : '';
            const msg = log && log.message ? String(log.message) : '';
            return `${ts}|${lvl}|${msg}`;
        }
        
        function appendCameraLogLine(log, logsContainer) {
            const timestamp = new Date(log.timestamp).toLocaleString();
            const levelClass = log.level === 'error' ? 'text-danger' : 
                             log.level === 'warn' ? 'text-warning' : 'text-info';

            const line = document.createElement('div');
            line.className = `${levelClass} mb-1 d-flex align-items-center`;

            const text = document.createElement('span');
            text.className = 'flex-grow-1';
            text.textContent = `[${timestamp}] ${log.message}`;

            const rtspMatch = typeof log.message === 'string' ? log.message.match(/rtsp:\/\/[^\s<]+/i) : null;
            if (rtspMatch && rtspMatch[0] && onvifRtspMap && onvifRtspMap.has(rtspMatch[0])) {
                text.style.cursor = 'pointer';
                text.style.textDecoration = 'underline';
                text.dataset.rtsp = onvifRtspMap.get(rtspMatch[0]);
                text.addEventListener('dblclick', () => {
                    applyRtspToCameraSettings(text.dataset.rtsp);
                });
            }

            line.appendChild(text);
            logsContainer.appendChild(line);
        }
        
        // 直接向UI添加摄像头日志（用于实时错误显示）
        function addCameraLogToUI(level, message) {
            const logsContainer = document.getElementById('camera-logs');
            if (!logsContainer) return;
            
            const timestamp = new Date().toLocaleString();
            const levelClass = level === 'error' ? 'text-danger' : 
                             level === 'warn' ? 'text-warning' : 'text-info';
            
            const logEntry = `<div class="${levelClass} mb-1">[${timestamp}] ${message}</div>`;
            
            // 如果容器为空或只有"暂无日志信息"，则替换内容
            if (logsContainer.innerHTML.includes('暂无日志信息') || logsContainer.innerHTML.trim() === '') {
                logsContainer.innerHTML = logEntry;
            } else {
                // 否则添加到末尾
                logsContainer.innerHTML = logsContainer.innerHTML + logEntry;
            }
            
            // 自动滚动到底部显示最新日志
            logsContainer.scrollTop = logsContainer.scrollHeight;
        }
        
        // 刷新摄像头日志
        async function refreshCameraLogs() {
            try {
                const response = await fetch('/api/camera/logs');
                const data = await response.json();
                
                const logsContainer = document.getElementById('camera-logs');
                if (data.success && data.logs && data.logs.length > 0) {
                    const shouldStickToBottom = (logsContainer.scrollHeight - (logsContainer.scrollTop + logsContainer.clientHeight)) < 40;

                    if (logsContainer.innerHTML.includes('暂无日志信息') || logsContainer.innerHTML.includes('获取日志失败') || logsContainer.innerHTML.includes('日志已清空')) {
                        logsContainer.innerHTML = '';
                        renderedCameraLogKeys = new Set();
                    }

                    const logs = data.logs.slice().reverse();
                    for (const log of logs) {
                        const key = buildCameraLogKey(log);
                        if (renderedCameraLogKeys.has(key)) continue;
                        appendCameraLogLine(log, logsContainer);
                        renderedCameraLogKeys.add(key);
                    }
                    
                    // 自动滚动到底部显示最新日志
                    if (shouldStickToBottom) {
                        logsContainer.scrollTop = logsContainer.scrollHeight;
                    }
                } else {
                    if (!logsContainer.innerHTML || logsContainer.innerHTML.trim() === '') {
                        logsContainer.innerHTML = '<div class="text-muted text-center">暂无日志信息</div>';
                    }
                }
            } catch (error) {
                console.error('获取摄像头日志失败:', error);
                const logsContainer = document.getElementById('camera-logs');
                if (!logsContainer.innerHTML || logsContainer.innerHTML.trim() === '' || logsContainer.innerHTML.includes('暂无日志信息')) {
                    logsContainer.innerHTML = '<div class="text-danger text-center">获取日志失败</div>';
                } else {
                    addCameraLogToUI('warn', '获取摄像头日志失败');
                }
