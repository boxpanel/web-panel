        // 执行保存设置的实际操作
        function performSaveSettings() {
            // 获取系统设置
            const serverPortElement = document.getElementById('server-port');
            const systemNameElement = document.getElementById('system-name');
            const sessionTimeoutElement = document.getElementById('session-timeout');
            
            // 检查元素是否存在
            if (!serverPortElement || !systemNameElement || !sessionTimeoutElement) {
                showErrorAlert('页面元素未找到，请刷新页面重试', '系统错误');
                return;
            }
            
            const serverPort = serverPortElement.value;
            const systemName = systemNameElement.value;
            const sessionTimeout = sessionTimeoutElement.value;
            
            // 验证系统设置输入
            if (!serverPort || !systemName || !sessionTimeout) {
                showErrorAlert('请填写所有必填字段', '输入错误');
                return;
            }
            
            const portNum = parseInt(serverPort);
            if (isNaN(portNum) || portNum < 1024 || portNum > 65535) {
                showErrorAlert('端口号必须在1024-65535之间', '输入错误');
                return;
            }
            
            const timeoutNum = parseInt(sessionTimeout);
            if (isNaN(timeoutNum) || timeoutNum < 1 || timeoutNum > 1440) {
                showErrorAlert('会话超时时间必须在1-1440分钟之间', '输入错误');
                return;
            }
            
            const systemSettings = {
                serverPort: portNum,
                systemName: systemName,
                sessionTimeout: timeoutNum
            };
            
            // 保存系统设置
            fetch('/api/system-settings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(systemSettings)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessAlert('系统设置保存成功！');
                    // 重置设置变更状态
                    resetSettingsState();
                    // 重新初始化设置检测（更新原始值）
