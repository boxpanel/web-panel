        // 美化弹窗函数
        function beautifulAlert(message, type = 'info', title = '提示', position = 'center') {
            return new Promise((resolve) => {
                const modal = document.getElementById('beautifulAlertModal');
                const modalElement = new bootstrap.Modal(modal, {
                    backdrop: false,
                    keyboard: true
                });
                
                // 设置内容
                document.getElementById('alertModalTitle').textContent = title;
                document.getElementById('alertModalMessage').innerHTML = message;
                
                // 设置样式和图标
                const header = document.getElementById('alertModalHeader');
                const icon = document.getElementById('alertModalIcon');
                
                // 清除之前的样式类
                modal.className = 'modal fade beautiful-modal';
                header.className = 'modal-header border-0 text-white position-relative';
                
                // 根据位置参数调整模态框位置
                const modalDialog = modal.querySelector('.modal-dialog');
                if (position === 'top') {
                    modalDialog.style.marginTop = '50px';
                    modalDialog.style.marginBottom = 'auto';
                } else {
                    modalDialog.style.marginTop = '';
                    modalDialog.style.marginBottom = '';
                }
                
                switch(type) {
                    case 'success':
                        modal.classList.add('alert-success');
                        icon.innerHTML = '<i class="bi bi-check-circle-fill" style="font-size: 2rem;"></i>';
                        document.getElementById('alertModalSubtitle').textContent = '操作成功';
                        break;
                    case 'error':
                        modal.classList.add('alert-error');
                        icon.innerHTML = '<i class="bi bi-x-circle-fill" style="font-size: 2rem;"></i>';
                        document.getElementById('alertModalSubtitle').textContent = '操作失败';
                        break;
                    case 'warning':
                        modal.classList.add('alert-warning');
                        icon.innerHTML = '<i class="bi bi-exclamation-triangle-fill" style="font-size: 2rem;"></i>';
                        document.getElementById('alertModalSubtitle').textContent = '警告信息';
                        break;
                    default:
                        modal.classList.add('alert-info');
                        icon.innerHTML = '<i class="bi bi-info-circle-fill" style="font-size: 2rem;"></i>';
                        document.getElementById('alertModalSubtitle').textContent = '提示信息';
                }
                
                // 绑定确定按钮事件
                const okBtn = document.getElementById('alertModalOkBtn');
                const handleOk = () => {
                    modalElement.hide();
                    okBtn.removeEventListener('click', handleOk);
                    resolve(true);
                };
                okBtn.addEventListener('click', handleOk);
                
                // 显示弹窗
                modalElement.show();
                
                // 添加脉冲动画
                setTimeout(() => {
                    modal.querySelector('.modal-content').classList.add('modal-pulse');
                }, 100);
            });
        }
        
        function beautifulConfirm(message, title = '确认操作') {
            return new Promise((resolve) => {
                const modal = document.getElementById('beautifulConfirmModal');
                const modalElement = new bootstrap.Modal(modal, {
                    backdrop: false,
                    keyboard: true
                });
                
                // 设置内容
                document.getElementById('confirmModalTitle').textContent = title;
                document.getElementById('confirmModalMessage').textContent = message;
                
                // 添加样式类
                modal.className = 'modal fade beautiful-modal';
                
                // 绑定按钮事件
                const okBtn = document.getElementById('confirmModalOkBtn');
                const handleOk = () => {
                    modalElement.hide();
                    okBtn.removeEventListener('click', handleOk);
                    resolve(true);
                };
                okBtn.addEventListener('click', handleOk);
                
                // 绑定取消事件
                const handleCancel = () => {
                    modalElement.hide();
                    modal.removeEventListener('hidden.bs.modal', handleCancel);
                    resolve(false);
                };
                modal.addEventListener('hidden.bs.modal', handleCancel);
                
                // 显示弹窗
                modalElement.show();
                
                // 添加脉冲动画
                setTimeout(() => {
                    modal.querySelector('.modal-content').classList.add('modal-pulse');
                }, 100);
            });
        }
        
        function beautifulPrompt(message, defaultValue = '', title = '输入信息') {
            return new Promise((resolve) => {
                const modal = document.getElementById('beautifulPromptModal');
                const modalElement = new bootstrap.Modal(modal);
                
                // 设置内容
                document.getElementById('promptModalTitle').textContent = title;
                document.getElementById('promptModalLabel').textContent = message;
                const input = document.getElementById('promptModalInput');
                input.value = defaultValue;
                
                // 添加样式类
                modal.className = 'modal fade beautiful-modal';
                
                // 绑定确定按钮事件
                const okBtn = document.getElementById('promptModalOkBtn');
                const handleOk = () => {
                    const value = input.value.trim();
                    modalElement.hide();
                    okBtn.removeEventListener('click', handleOk);
                    resolve(value || null);
                };
                okBtn.addEventListener('click', handleOk);
                
                // 绑定取消事件
                const handleCancel = () => {
                    modalElement.hide();
                    modal.removeEventListener('hidden.bs.modal', handleCancel);
                    resolve(null);
                };
                modal.addEventListener('hidden.bs.modal', handleCancel);
                
                // 绑定回车键
                const handleEnter = (e) => {
                    if (e.key === 'Enter') {
                        handleOk();
                    }
                };
                input.addEventListener('keypress', handleEnter);
                
                // 显示弹窗
                modalElement.show();
                
                // 聚焦输入框
                setTimeout(() => {
                    input.focus();
                    input.select();
                    modal.querySelector('.modal-content').classList.add('modal-pulse');
                }, 300);
            });
        }
        
        // 替换原有的弹窗函数
        function showSuccessAlert(message, title = '成功', position = 'center') {
            return beautifulAlert(message, 'success', title, position);
        }
        
        function showErrorAlert(message, title = '错误') {
            return beautifulAlert(message, 'error', title);
        }
        
        function showWarningAlert(message, title = '警告') {
            return beautifulAlert(message, 'warning', title);
        }
        
        function showCenteredAlert(message, title = '提示') {
            return beautifulAlert(message, 'info', title);
        }

