                                    <tr><td>发送错误</td><td>${data.txErrors || '0'}</td></tr>
                                    <tr><td>接收丢包</td><td>${data.rxDropped || '0'}</td></tr>
                                    <tr><td>发送丢包</td><td>${data.txDropped || '0'}</td></tr>
                                </table>
                            </div>
                        </div>
                    `;
                })
                .catch(error => {
                    console.error('加载接口详细信息失败:', error);
                    const content = document.getElementById('interface-details-content');
                    if (content) {
                        content.innerHTML = `<div class="alert alert-danger">加载详细信息失败: ${error.message}</div>`;
