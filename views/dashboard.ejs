        // 创建桥接
        function createBridge() {
            const bridgeName = document.getElementById('bridgeName').value.trim();
            
            // 获取选中的目标接口
            const selectedInterfaces = [];
            const checkboxes = document.querySelectorAll('input[name="targetInterfaces"]:checked');
            checkboxes.forEach(checkbox => {
                selectedInterfaces.push(checkbox.value);
            });
            
            const bridgeType = 'bridge'; // 默认使用标准桥接
            
            // 获取IP配置选项
            const ipConfigType = document.querySelector('input[name="ipConfigType"]:checked').value;
            
            if (!bridgeName || selectedInterfaces.length === 0) {
                showWarningAlert('请填写桥接名称并至少选择一个目标接口');
                return;
            }
            
            // 验证桥接名称格式
            if (!/^[a-zA-Z][a-zA-Z0-9_-]*$/.test(bridgeName)) {
                showWarningAlert('桥接名称格式不正确，请使用字母开头，只包含字母、数字、下划线和连字符');
                return;
            }
            
            // 如果选择静态IP，验证静态IP配置
            let ipConfig = {
                type: ipConfigType
            };
            
            if (ipConfigType === 'static') {
                const staticIpAddress = document.getElementById('staticIpAddress').value.trim();
                const staticSubnetMask = document.getElementById('staticSubnetMask').value.trim();
                const staticGateway = document.getElementById('staticGateway').value.trim();
                
                if (!staticIpAddress || !staticSubnetMask || !staticGateway) {
                    showWarningAlert('静态IP配置不完整，请填写IP地址、子网掩码和网关');
                    return;
                }
                
                // 简单的IP地址格式验证
                const ipRegex = /^(\d{1,3}\.){3}\d{1,3}$/;
                if (!ipRegex.test(staticIpAddress)) {
                    showWarningAlert('IP地址格式不正确');
                    return;
                }
                if (!ipRegex.test(staticSubnetMask)) {
                    showWarningAlert('子网掩码格式不正确');
                    return;
                }
                if (!ipRegex.test(staticGateway)) {
                    showWarningAlert('网关地址格式不正确');
                    return;
                }
                
                ipConfig.staticIp = {
                    address: staticIpAddress,
                    netmask: staticSubnetMask,
                    gateway: staticGateway
                };
            }
            
            const bridgeData = {
                bridgeName: bridgeName,
                targetInterfaces: selectedInterfaces,
                type: bridgeType,
                ipConfig: ipConfig
            };
            
            // 显示创建中状态
            const createBtn = document.querySelector('#createBridgeModal .btn-success');
            const originalText = createBtn.innerHTML;
            createBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>创建中...';
            createBtn.disabled = true;
            
            fetch('/api/network-bridge/create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(bridgeData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccessAlert('桥接创建成功！正在重新载入页面以应用新的网络配置...');
                    // 关闭模态框
                    const modal = bootstrap.Modal.getInstance(document.getElementById('createBridgeModal'));
                    modal.hide();
                    
                    // 延迟3秒后重新载入页面，给用户时间看到成功提示
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    showErrorAlert('桥接创建失败: ' + (data.error || '未知错误'));
                }
            })
            .catch(error => {
                console.error('创建桥接失败:', error);
                showErrorAlert('创建桥接失败: ' + error.message);
            })
            .finally(() => {
                // 恢复按钮状态
                createBtn.innerHTML = originalText;
                createBtn.disabled = false;
            });
        }
        
