                    }
                    
                    refreshFileList();
                    
                    // 显示详细结果
                    let message = result.message;
                    if (result.errorFiles && result.errorFiles.length > 0) {
                        message += `\n失败的文件: ${result.errorFiles.map(f => f.file).join(', ')}`;
                    }
                    showSuccessAlert(message);
                } else {
                    throw new Error(result.error || `${operation}操作失败`);
                }
            } catch (error) {
                console.error('粘贴操作失败:', error);
                showErrorAlert(`${operation}操作失败: ${error.message}`);
            }
        }
        
