                                    </div>
                                </div>
                                

                            </div>
                            <div class="modal-footer justify-content-center">
                                <button type="button" class="btn btn-success" onclick="confirmUpload()" id="confirmUploadBtn" disabled>
                                    <i class="bi bi-upload me-1"></i>确认上传
                                </button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i>取消
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // 移除已存在的模态框
            const existingModal = document.getElementById('uploadModal');
            if (existingModal) {
                existingModal.remove();
            }
            
            // 添加新模态框
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            // 显示模态框
            const modal = new bootstrap.Modal(document.getElementById('uploadModal'));
            modal.show();
            
            // 绑定文件选择事件
            const fileInput = document.getElementById('uploadFileInput');
            const uploadArea = document.getElementById('uploadArea');
            
            // 格式化文件大小函数
            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
            }
            
            function handleFiles(files) {
                const container = document.getElementById('selectedFilesContainer');
                const filesList = document.getElementById('selectedFilesList');
                const confirmBtn = document.getElementById('confirmUploadBtn');
                
                if (files.length > 0) {
                    container.style.display = 'block';
                    filesList.innerHTML = Array.from(files).map(file => 
                        `<li class="text-muted"><i class="bi bi-file-earmark me-1"></i>${file.name} (${formatFileSize(file.size)})</li>`
                    ).join('');
                    confirmBtn.disabled = false;
                    
                    // 更新上传区域显示
                    const uploadContent = uploadArea.querySelector('.upload-content');
                    uploadContent.innerHTML = `
                        <i class="bi bi-check-circle-fill upload-icon text-success"></i>
                        <h5 class="upload-title text-success">已选择 ${files.length} 个文件</h5>
                        <p class="upload-subtitle text-muted">点击重新选择文件</p>
                    `;
                } else {
                    container.style.display = 'none';
                    confirmBtn.disabled = true;
                }
            }
            
            fileInput.addEventListener('change', function(e) {
                handleFiles(e.target.files);
            });
            
            // 拖拽功能
            uploadArea.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.stopPropagation();
                uploadArea.classList.add('dragover');
            });
            
            uploadArea.addEventListener('dragleave', function(e) {
                e.preventDefault();
                e.stopPropagation();
                uploadArea.classList.remove('dragover');
            });
            
            uploadArea.addEventListener('drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                uploadArea.classList.remove('dragover');
                
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    // 将文件设置到input元素
                    fileInput.files = files;
                    handleFiles(files);
                }
            });
            
            // 防止页面默认拖拽行为
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                uploadArea.addEventListener(eventName, function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                });
            });
            
    }
    
    // 确认上传
    function confirmUpload() {
        const fileInput = document.getElementById('uploadFileInput');
        const files = Array.from(fileInput.files);
        const uploadPath = currentPath;
        
        if (files.length === 0) {
            showErrorAlert('请选择要上传的文件', '选择错误');
            return;
        }
        
        // 关闭模态框
        const modal = bootstrap.Modal.getInstance(document.getElementById('uploadModal'));
        modal.hide();
        
        // 创建FormData对象
        const formData = new FormData();
        files.forEach(file => {
            formData.append('files', file);
        });
        formData.append('currentPath', uploadPath);
        
        // 显示上传进度在屏幕中间
        const uploadStatus = document.createElement('div');
        uploadStatus.className = 'alert alert-info alert-dismissible fade show position-fixed';
        uploadStatus.style.cssText = `
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1060;
            min-width: 400px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        `;
        uploadStatus.innerHTML = `
            <i class="bi bi-upload"></i> 正在上传 ${files.length} 个文件到 ${uploadPath}...
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(uploadStatus);
        
        // 发送上传请求
        fetch('/api/files/upload', {
                credentials: 'same-origin',
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            uploadStatus.remove();
            if (data.success) {
                showSuccessAlert(data.message);
                loadDirectory(currentPath); // 刷新列表
            } else {
                showErrorAlert('上传失败: ' + data.error);
            }
        })
        .catch(error => {
            uploadStatus.remove();
            console.error('上传失败:', error);
            showErrorAlert('上传失败: ' + error.message);
        });
        }
        
