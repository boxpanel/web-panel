                                                <button class="btn btn-outline-secondary btn-sm" id="clear-hex">
                                                    <i class="bi bi-trash"></i> 清空
                                                </button>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <div id="radar-hex-output" style="height: 200px; overflow-y: auto; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 5px; padding: 10px; font-family: 'Courier New', monospace; font-size: 12px; white-space: pre-wrap;"></div>
                                        </div>
                                    </div>
                                </div>
                                <!-- 右侧 串口控制 -->
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <h6 class="mb-0">串口连接</h6>
                                        </div>
                                        <div class="card-body">
                                            <!-- 车道数量 -->
                                            <div class="mb-3">
                                                <div class="d-flex align-items-center">
                                                    <label class="form-label mb-0" style="width: 80px;">车道数量</label>
                                                    <select id="lane-count" class="form-select" style="width: 130px;">
                                                        <option value="1">1</option>
                                                        <option value="2">2</option>
                                                        <option value="3">3</option>
                                                        <option value="4" selected>4</option>
                                                        <option value="5">5</option>
                                                        <option value="6">6</option>
                                                        <option value="7">7</option>
                                                        <option value="8">8</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <!-- 车道宽度（位于车道数量下方，并与其对齐） -->
                                            <div class="mb-3">
                                                <div class="d-flex align-items-center">
                                                    <label class="form-label mb-0" style="width: 80px;">车道宽度</label>
                                                    <div class="input-group" style="width: 130px;">
                                                        <input id="lane-width" type="number" class="form-control" min="2" max="12" step="0.1" value="6.0">
                                                        <span class="input-group-text">m</span>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="mb-3">
                                                <label class="form-label mb-0">已授权串口设备</label>
                                                <div class="d-flex align-items-center mt-2" style="gap: 8px;">
                                                    <select id="authorized-ports" class="form-select" style="width: 70%;">
                                                        <option value="">暂无已授权设备，请点击刷新</option>
                                                    </select>
                                                    <button id="refresh-ports" class="btn btn-outline-secondary" type="button" style="height: calc(1.5em + .75rem + 2px); display: inline-flex; align-items: center;">
                                                        <i class="bi bi-arrow-clockwise"></i> 刷新
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">波特率</label>
                                                <select id="radar-baud-rate" class="form-select" style="width: 130px;">
                                                    <option value="9600">9600</option>
                                                    <option value="19200">19200</option>
                                                    <option value="38400">38400</option>
                                                    <option value="57600">57600</option>
                                                    <option value="115200" selected>115200</option>
                                                    <option value="230400">230400</option>
                                                    <option value="460800">460800</option>
                                                    <option value="921600">921600</option>
                                                    <option value="1000000">1000000</option>
                                                    <option value="1500000">1500000</option>
                                                </select>
                                            </div>
                                            <div class="d-flex gap-2 mb-3">
                                                <button id="radar-connect" class="btn btn-success">
                                                    <i class="bi bi-plug"></i> 连接
                                                </button>
                                                <button id="radar-disconnect" class="btn btn-outline-danger" disabled>
                                                    <i class="bi bi-x-circle"></i> 断开
                                                </button>
                                            </div>
                                            <div class="mb-2">
                                                <span class="badge bg-secondary" id="radar-conn-status">未连接</span>
                                            </div>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 进程监控内容 -->
        <div id="process-monitor-content" class="content-section" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <div class="card">
