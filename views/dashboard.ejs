        // 确认浏览器下载
        function confirmBrowserDownload(fileNames) {
            // 如果没有传入文件名，从选中的复选框获取
            if (!fileNames) {
                const checked = document.querySelectorAll('#file-list input[type="checkbox"]:checked');
                fileNames = Array.from(checked).map(cb => cb.value);
            }
            
            if (fileNames.length === 0) {
                showErrorAlert('请选择要下载的文件', '选择错误');
                return;
            }
            
            // 显示下载进度提示在屏幕中间
            const downloadStatus = document.createElement('div');
            downloadStatus.className = 'alert alert-info alert-dismissible fade show position-fixed';
            downloadStatus.style.cssText = `
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                z-index: 1060;
                min-width: 400px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            `;
            downloadStatus.innerHTML = `
                <i class="bi bi-download"></i> 正在准备下载 ${fileNames.length} 个文件...
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(downloadStatus);
            
            // 为每个文件创建下载链接
            fileNames.forEach((fileName, index) => {
                setTimeout(() => {
                    const link = document.createElement('a');
                    link.href = `/api/files/download-single?path=${encodeURIComponent(currentPath)}&file=${encodeURIComponent(fileName)}`;
                    link.download = fileName;
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }, index * 500); // 每个文件间隔500ms下载，避免浏览器阻止
            });
            
            // 3秒后移除下载状态提示
            setTimeout(() => {
                downloadStatus.remove();
                
                // 显示下载完成提示
                const successStatus = document.createElement('div');
                successStatus.className = 'alert alert-success alert-dismissible fade show position-fixed';
                successStatus.style.cssText = `
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    z-index: 1060;
                    min-width: 400px;
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                `;
                successStatus.innerHTML = `
                    <i class="bi bi-check-circle"></i> ${fileNames.length} 个文件已开始下载到您的默认下载文件夹
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(successStatus);
                
                // 5秒后自动移除成功提示
                setTimeout(() => {
                    successStatus.remove();
                }, 5000);
                
                // 清除选择状态
                document.querySelectorAll('#file-list input[type="checkbox"]:checked').forEach(cb => cb.checked = false);
                document.getElementById('select-all').checked = false;
                updateBatchOperations();
            }, 3000);
        }
        
        // 树型文件夹展开/折叠函数
        function toggleFolder(element) {
            const children = element.parentElement.querySelector('.folder-children');
            const toggleIcon = element.querySelector('.toggle-icon');
            
            if (children.style.display === 'none') {
                children.style.display = 'block';
                toggleIcon.classList.remove('bi-chevron-right');
                toggleIcon.classList.add('bi-chevron-down');
            } else {
                children.style.display = 'none';
                toggleIcon.classList.remove('bi-chevron-down');
                toggleIcon.classList.add('bi-chevron-right');
            }
        }
        
