            // 动态填充文件列表
            const fileListContainer = document.getElementById('deleteFileList');
            fileNames.forEach(name => {
                // 获取文件类型图标
                const fileRow = Array.from(document.querySelectorAll('#file-list tr')).find(row => {
                    const nameCell = row.querySelector('td:nth-child(2)');
                    return nameCell && nameCell.textContent.trim() === name;
                });
                const isFolder = fileRow && fileRow.querySelector('.bi-folder-fill') !== null;
                const icon = isFolder ? 'bi-folder-fill text-warning' : 'bi-file-earmark text-primary';
                
                const listItem = document.createElement('li');
