                return;
            }
            
            const fileText = selectedFiles.length === 1 ? `文件 "${selectedFiles[0]}"` : `${selectedFiles.length} 个文件/文件夹`;
            
            try {
                // 调用后端API删除文件
                const response = await fetch('/api/files/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        files: selectedFiles,
                        currentPath: currentPath
                    })
                });
                
                console.log('删除响应状态:', response.status);
                console.log('删除响应头:', response.headers.get('content-type'));
                
                // 检查是否是认证错误
                if (response.status === 401) {
                    showErrorAlert('会话已过期，请重新登录', '认证错误');
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 2000);
                    return;
                }
                
                if (response.status === 404) {
                    showErrorAlert('删除接口不存在，请检查服务器配置', '接口错误');
                    return;
                }
                
                if (!response.ok) {
                    throw new Error(`HTTP错误! 状态: ${response.status}`);
                }
                
                // 检查响应是否为JSON格式
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    showErrorAlert('服务器返回了非预期的响应格式', '服务器错误');
                    return;
                }
                
                const result = await response.json();
                console.log('删除结果:', result);
                
                if (result.success) {
                    beautifulAlert(`成功删除 ${fileText}`, 'success', '删除成功');
                    refreshFileList();
                    // 清除选择状态
                    document.getElementById('select-all').checked = false;
                } else {
                    showErrorAlert(result.message || result.error || '删除失败', '删除错误');
                }
            } catch (error) {
                console.error('删除文件时出错:', error);
                // 检查是否是JSON解析错误
                if (error.message.includes('Unexpected token') && error.message.includes('<!DOCTYPE')) {
                    showErrorAlert('会话可能已过期，请刷新页面重试', '会话错误');
                } else {
                    showErrorAlert(`删除文件时发生错误: ${error.message}`, '网络错误');
                }
            }
        }
        
