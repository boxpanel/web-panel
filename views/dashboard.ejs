        // 加载接口详细信息
        function loadInterfaceDetails(interfaceName) {
            fetch(`/api/network-interface-details?interface=${encodeURIComponent(interfaceName)}`)
                .then(response => {
                    if (response.status === 401) {
                        window.location.href = '/login';
                        return;
                    }
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        throw new Error('响应不是JSON格式');
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data) return;
                    
                    const content = document.getElementById('interface-details-content');
                    if (!content) {
                        console.error('找不到interface-details-content元素');
                        return;
                    }
                    if (data.error) {
                        content.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
                        return;
                    }
                    
                    // 显示详细信息
                    content.innerHTML = `
                        <div class="row">
                            <div class="col-md-6">
                                <h6>基本信息</h6>
                                <table class="table table-sm">
                                    <tr><td>接口名称</td><td>${data.name || 'N/A'}</td></tr>
                                    <tr><td>类型</td><td>${data.type || 'N/A'}</td></tr>
                                    <tr><td>IPv4地址</td><td>${data.ipv4 || 'N/A'}</td></tr>
                                    <tr><td>IPv6地址</td><td>${data.ipv6 || 'N/A'}</td></tr>
                                    <tr><td>子网掩码</td><td>${data.netmask || 'N/A'}</td></tr>
                                    <tr><td>网关</td><td>${data.gateway || 'N/A'}</td></tr>
                                    <tr><td>MAC地址</td><td>${data.mac || 'N/A'}</td></tr>
                                    <tr><td>MTU</td><td>${data.mtu || 'N/A'}</td></tr>
                                    <tr><td>速度</td><td>${data.speed || 'N/A'}</td></tr>
                                    <tr><td>双工模式</td><td>${data.duplex || 'N/A'}</td></tr>
                                    <tr><td>操作状态</td><td><span class="badge bg-${data.operstate === 'up' ? 'success' : 'secondary'}">${data.operstate || 'N/A'}</span></td></tr>
                                    <tr><td>载波状态</td><td>${data.carrier || 'N/A'}</td></tr>

                                </table>
                            </div>
                            <div class="col-md-6">
