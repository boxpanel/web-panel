                            <div class="btn-group">
                                <button type="button" class="btn btn-light btn-action dropdown-toggle rounded-3 border" data-bs-toggle="dropdown" aria-expanded="false" title="创建" style="background-color: #f8f9fa; border-color: #dee2e6; color: #495057;">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>创建</span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="createFile()">
                                            <i class="bi bi-file-plus me-2"></i>新建文件
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="createFolder()">
                                            <i class="bi bi-folder-plus me-2"></i>新建文件夹
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <button class="btn btn-light btn-action me-2 rounded-3 border" onclick="uploadFile()" title="上传文件" style="background-color: #f8f9fa; border-color: #dee2e6; color: #495057;">
                                <i class="bi bi-cloud-upload"></i>
                                <span>上传</span>
                            </button>
                            <button id="batch-copy-btn" class="btn btn-light btn-action me-2 rounded-3 border" onclick="copySelected()" title="复制选中文件" style="background-color: #f8f9fa; border-color: #dee2e6; color: #495057;">
                                <i class="bi bi-files" style="font-size: 1.1em; margin-right: 4px;"></i>
                                <span>复制</span>
                            </button>
                            <button id="batch-move-btn" class="btn btn-light btn-action me-2 rounded-3 border" onclick="cutSelected()" title="移动选中文件" style="background-color: #f8f9fa; border-color: #dee2e6; color: #495057;">
                                <i class="bi bi-scissors"></i>
                                <span>移动</span>
                            </button>
                            <button id="batch-paste-btn" class="btn btn-light btn-action me-2 rounded-3 border" onclick="pasteFiles()" title="粘贴文件" style="background-color: #f8f9fa; border-color: #dee2e6; color: #495057;">
                                <i class="bi bi-clipboard"></i>
                                <span>粘贴</span>
                            </button>
                            <button class="btn btn-light btn-action me-2 rounded-3 border" id="batch-compress-btn" onclick="compressSelected()" title="压缩选中文件" style="background-color: #f8f9fa; border-color: #dee2e6; color: #495057;">
