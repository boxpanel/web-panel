        // 复制路径
        function copyPath(fileName) {
            const fullPath = currentPath + '/' + fileName;
            
            // 使用现代浏览器的Clipboard API
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(fullPath).then(() => {
                    showSuccessAlert(`路径已复制到剪贴板: ${fullPath}`, '复制成功');
                }).catch(err => {
                    console.error('复制失败:', err);
                    fallbackCopyPath(fullPath);
                });
            } else {
                fallbackCopyPath(fullPath);
            }
        }
        
        // 备用复制方法
        function fallbackCopyPath(path) {
            const textArea = document.createElement('textarea');
            textArea.value = path;
            textArea.style.position = 'fixed';
            textArea.style.left = '-999999px';
            textArea.style.top = '-999999px';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            
            try {
                document.execCommand('copy');
                showSuccessAlert(`路径已复制到剪贴板: ${path}`, '复制成功');
            } catch (err) {
                console.error('复制失败:', err);
                showErrorAlert('复制路径失败，请手动复制: ' + path);
            } finally {
                document.body.removeChild(textArea);
            }
        }
        
