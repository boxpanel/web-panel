        // 启动网络接口自动刷新
        function startNetworkAutoRefresh() {
            // 先清除已存在的定时器
            stopNetworkAutoRefresh();
            
            // 每60秒自动刷新一次网络接口状态
            networkAutoRefreshTimer = setInterval(() => {
                // 只有在网络监控页面激活时才刷新
                const networkSection = document.getElementById('network');
                if (networkSection && networkSection.style.display !== 'none') {
                    console.log('自动刷新网络接口状态...');
                    loadNetworkInfo();
                }
            }, 60000); // 60秒间隔，减少频率
            
            console.log('网络接口自动刷新已启动 (60秒间隔)');
        }
        
        // 停止网络接口自动刷新
        function stopNetworkAutoRefresh() {
            if (networkAutoRefreshTimer) {
                clearInterval(networkAutoRefreshTimer);
                networkAutoRefreshTimer = null;
                console.log('网络接口自动刷新已停止');
            }
        }
        

        
        // 自动连接状态更新功能已移除
        
        // 更新DHCP转发状态显示
        function updateDhcpForwardingStatus(interfaceName, dhcpForwardingResult, enabled) {
            console.log(`更新接口 ${interfaceName} 的DHCP转发状态:`, dhcpForwardingResult);
            
            const dhcpStatus = document.getElementById(`dhcp-status-${interfaceName}`);
            if (!dhcpStatus) {
                console.warn(`未找到DHCP转发状态元素: dhcp-status-${interfaceName}`);
                return;
            }
            
            if (!enabled) {
                // 转发通道关闭时，DHCP转发也关闭
                dhcpStatus.innerHTML = '<i class="bi bi-dash-circle me-1"></i>未启用';
                dhcpStatus.className = 'badge bg-secondary bg-opacity-10 text-secondary small';
                dhcpStatus.title = '转发通道未开启，DHCP转发功能不可用';
                return;
            }
            
            if (dhcpForwardingResult.applied) {
                // DHCP转发配置成功
                dhcpStatus.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>已启用';
                dhcpStatus.className = 'badge bg-success bg-opacity-10 text-success small';
                dhcpStatus.title = 'DHCP请求将被转发到当前接口的网关';
            } else {
                // DHCP转发配置失败
                dhcpStatus.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>配置失败';
                dhcpStatus.className = 'badge bg-warning bg-opacity-10 text-warning small';
                
                if (dhcpForwardingResult.errors && dhcpForwardingResult.errors.length > 0) {
                    const errorMessages = dhcpForwardingResult.errors.map(e => e.error || e.message || e).join('; ');
                    dhcpStatus.title = `DHCP转发配置失败: ${errorMessages}`;
                } else {
                    dhcpStatus.title = 'DHCP转发配置失败，请检查系统日志';
                }
            }
        }
        
