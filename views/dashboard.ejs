                    }
                    
                    if (data.interfaces && data.interfaces.length > 0) {
                        interfacesContainer.innerHTML = data.interfaces.map(iface => {
                            const isBridged = iface.isBridged || false;
                            const cardClass = isBridged ? 'card border-0 shadow-sm h-100 bridged' : 'card border-0 shadow-sm h-100';
