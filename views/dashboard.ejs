        // 确认批量删除
        function confirmBatchDelete(fileNames) {
            // 关闭模态框
            const modal = bootstrap.Modal.getInstance(document.getElementById('batchDeleteModal'));
            modal.hide();
            
            // 调用批量删除API
            Promise.all(fileNames.map(fileName => {
                const fileRow = document.querySelector(`[data-filename="${fileName}"]`);
                const isFolder = fileRow && fileRow.querySelector('.bi-folder-fill') !== null;
                
                return fetch('/api/files', {
                credentials: 'same-origin',
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        path: currentPath,
                        name: fileName,
                        type: isFolder ? 'folder' : 'file'
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`删除 ${fileName} 失败`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data.success) {
                        throw new Error(`删除 ${fileName} 失败: ${data.error}`);
                    }
                    return fileName;
                });
            }))
            .then(deletedFiles => {
                showSuccessAlert(`成功删除 ${deletedFiles.length} 个文件/文件夹`);
                
                // 清除选择状态
                document.querySelectorAll('#file-list input[type="checkbox"]:checked').forEach(cb => cb.checked = false);
                document.getElementById('select-all').checked = false;
                updateBatchOperations();
                
                loadDirectory(currentPath); // 刷新列表
            })
            .catch(error => {
                console.error('批量删除失败:', error);
                showErrorAlert('批量删除失败: ' + error.message);
                
                // 即使失败也要刷新列表，因为可能部分删除成功
                loadDirectory(currentPath);
            });
        }
        
