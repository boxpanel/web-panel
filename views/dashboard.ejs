                            <h6>加载网络信息失败</h6>
                            <p class="small">请检查网络连接后重试</p>
                            <button class="btn btn-outline-primary btn-sm" onclick="loadNetworkInfo()">
                                <i class="bi bi-arrow-clockwise me-1"></i>重新加载
                            </button>
                        </div>
                    `;
                    }
                });
        }
        

        
        // 刷新网络接口
        function refreshNetworkInterfaces() {
            loadNetworkInfo();
        }
        
        // 获取主机网络配置
        async function getHostNetworkConfig() {
            try {
                const response = await fetch('/api/host-network-config');
                
                // 检查响应状态
                if (!response.ok) {
                    if (response.status === 401) {
                        console.warn('未登录或会话已过期，请刷新页面重新登录');
                        return null;
                    }
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                // 检查响应内容类型
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    console.error('服务器返回了非JSON响应，可能是错误页面');
                    return null;
                }
                
                const data = await response.json();
                
                if (data.success) {
                    return data.config;
                } else {
                    console.warn('获取主机网络配置失败:', data.error);
                    return null;
                }
            } catch (error) {
                console.error('获取主机网络配置出错:', error);
                return null;
            }
        }

        // 自动填充静态IP配置
        async function autoFillStaticIPConfig() {
            const config = await getHostNetworkConfig();
            if (config) {
                const ipAddressField = document.getElementById('staticIpAddress');
                const subnetMaskField = document.getElementById('staticSubnetMask');
                const gatewayField = document.getElementById('staticGateway');
                
                if (ipAddressField && config.ip) {
                    ipAddressField.value = config.ip;
                }
                if (subnetMaskField && config.netmask) {
                    subnetMaskField.value = config.netmask;
                }
                if (gatewayField && config.gateway) {
                    gatewayField.value = config.gateway;
                }
                
                // 静默自动填充，不显示提示
                console.log('已自动填充当前主机的网络配置:', config);
            } else {
                // 静默处理失败情况，不显示警告弹窗
                console.warn('无法获取主机网络配置，用户需要手动填写');
            }
        }

