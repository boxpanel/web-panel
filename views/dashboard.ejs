        // 开始压缩
        async function startCompress() {
            const selectedFiles = getSelectedFiles();
            const fileName = document.getElementById('compressFileName').value.trim();
            const format = document.querySelector('input[name="compressFormat"]:checked').value;
            const path = document.getElementById('compressPath').value;
            const highCompress = document.getElementById('compressLevel').checked;
            const usePassword = document.getElementById('compressPassword').checked;
            const password = usePassword ? document.getElementById('compressPasswordValue').value : '';
            
            if (!fileName) {
                showErrorAlert('请输入压缩包名称', '输入错误');
                return;
            }
            
            if (usePassword && !password) {
                showErrorAlert('请输入密码', '输入错误');
                return;
            }
            
            // 构建完整的文件名
            const fullFileName = fileName.includes('.') ? fileName : `${fileName}.${format}`;
            
            // 关闭面板
            closeCompressPanel();
            
            // 显示压缩进度
            beautifulAlert(`正在压缩 ${selectedFiles.length} 个文件为 ${fullFileName}...`, 'info', '压缩中');
            
            try {
                let requestBody;
                
                if (selectedFiles.length === 1) {
                    // 单个文件压缩
                    requestBody = {
                        path: path,
                        fileName: selectedFiles[0],
                        format: format,
                        options: {
                            highCompress: highCompress,
                            password: password
                        }
                    };
                } else {
                    // 多文件压缩
                    requestBody = {
                        path: path,
                        fileName: fullFileName,
                        files: selectedFiles,
                        format: format,
                        options: {
                            highCompress: highCompress,
                            password: password
                        }
                    };
                }
                
                const response = await fetch('/api/files/compress', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(requestBody)
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    showSuccessAlert(data.message || '压缩成功');
                    refreshFileList();
                } else {
                    showErrorAlert('压缩失败: ' + data.error);
                }
            } catch (error) {
                console.error('压缩失败:', error);
                showErrorAlert('压缩失败: ' + error.message);
            }
        }
        
