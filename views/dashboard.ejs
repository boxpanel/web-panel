        // 加载可用网络接口
        function loadAvailableInterfaces() {
            console.log('开始加载网络接口...');
            fetch('/api/network-interfaces')
                .then(response => {
                    console.log('API响应状态:', response.status);
                    return response.json();
                })
                .then(data => {
                    console.log('API返回数据:', data);
                    const targetInterfaceList = document.getElementById('targetInterfaceList');
                    
                    if (targetInterfaceList) {
                        if (data.interfaces && Array.isArray(data.interfaces)) {
                            console.log('找到接口数量:', data.interfaces.length);
                            
                            // 初始化复选框列表
                            targetInterfaceList.innerHTML = '';
                            
                            let addedCount = 0;
                            let usedCount = 0;
                            data.interfaces.forEach(iface => {
                                console.log('处理接口:', iface.name, '状态:', iface.status, '是否已使用:', iface.isUsed);
                                // 显示所有非回环接口，包括down状态的接口
                                if (iface.name && !iface.name.includes('Loopback') && !iface.name.includes('lo')) {
                                    const statusText = iface.status === 'up' ? '已连接' : '未连接';
                                    const ipText = iface.ip ? ` - ${iface.ip}` : '';
                                    const statusClass = iface.status === 'up' ? 'text-success' : 'text-warning';
                                    const statusBadge = `<span class="badge ${iface.status === 'up' ? 'bg-success' : 'bg-warning'} ms-2">${statusText}</span>`;
                                    
                                    // 如果接口已被使用，跳过显示
                                    if (iface.isUsed) {
                                        usedCount++;
                                        return;
                                    }
                                    
                                    const checkboxHtml = `
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" value="${iface.name}" id="interface_${iface.name}" name="targetInterfaces">
                                            <label class="form-check-label ${statusClass}" for="interface_${iface.name}">
                                                <strong>${iface.name}</strong> (${iface.type || 'Unknown'})${statusBadge}
                                                ${ipText ? `<br><small class="text-muted">${ipText}</small>` : ''}
                                            </label>
                                        </div>
                                    `;
                                    targetInterfaceList.innerHTML += checkboxHtml;
                                    addedCount++;
                                }
                            });
                            
                            console.log('添加了', addedCount, '个可用接口，', usedCount, '个接口已被使用');
                            
                            // 添加已使用接口的提示信息
                            if (usedCount > 0) {
                                const usedInterfaceInfo = `
                                    <div class="alert alert-info mt-2 mb-0" style="font-size: 0.875rem;">
                                        <i class="fas fa-info-circle me-1"></i>
                                        有 ${usedCount} 个网络接口已被其他桥接使用，因此不显示在列表中
                                    </div>
                                `;
                                targetInterfaceList.innerHTML += usedInterfaceInfo;
                            }
                            
                            if (addedCount === 0) {
                                if (usedCount > 0) {
                                    targetInterfaceList.innerHTML = `
                                        <div class="text-muted">没有可用的网络接口</div>
                                        <div class="alert alert-warning mt-2 mb-0" style="font-size: 0.875rem;">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            所有 ${usedCount} 个网络接口都已被其他桥接使用
