                                            <h6 class="mb-0">实时视频流</h6>
                                        </div>
                                        <div class="card-body text-center">
                                            <div id="camera-container" style="min-height: 300px; background: #f8f9fa; border: 2px dashed #dee2e6; border-radius: 10px; display: flex; align-items: center; justify-content: center; transition: height 0.3s ease;">
