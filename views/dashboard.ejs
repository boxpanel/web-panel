                            <button id="batch-delete-btn" class="btn btn-danger btn-action rounded-3 border" onclick="deleteSelected()" title="删除选中文件" style="background-color: #dc3545; border-color: #dc3545; color: #fff;">
                                <i class="bi bi-trash"></i>
                                <span>删除</span>
                            </button>
