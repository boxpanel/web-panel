    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/controls/OrbitControls.js"></script>
    <script>
        // 全局变量声明
        let resourceChart;
        // 雷达监控全局变量
        let radarPort = null;
        let radarReader = null;
        let radarAbortController = null;
let radarRenderer = null;
let radarScene = null;
        let radarCamera3D = null;
        let radarRoadGroup = null;
        let radarVehicle = null;
        let radarRoadLength = 400;
        let radarLaneCount = 4;
        let radarLaneWidth = 6;
let radarControls = null;
        let radarAuthorizedPorts = [];
let radarAnimating = false;
let radarAnimationId = null;
let radarVisibilityBound = false;
        
        // 初始化系统信息数据
        const systemData = {
            cpuUsage: <% if (systemInfo && systemInfo.cpu) { %><%= systemInfo.cpu.usage || 0 %><% } else { %>0<% } %>,
            memoryUsage: <% if (systemInfo && systemInfo.memory) { %><%= systemInfo.memory.usage || 0 %><% } else { %>0<% } %>
        };
        
        // 处理通知点击事件

        
        // 设置页面变更跟踪
        let settingsChanged = false;
        let originalSettings = {};

        // 页面内容切换功能
        function showSection(sectionId, element) {
            // 检查当前是否在设置页面且有未保存的更改
            const currentSettingsSection = document.getElementById('settings-content');
            if (currentSettingsSection && currentSettingsSection.style.display !== 'none' && sectionId !== 'settings' && settingsChanged) {
                // 显示确认对话框
                if (confirm('您有未保存的设置更改，确定要离开此页面吗？离开后更改将丢失。')) {
                    // 用户确认离开，重置设置状态
                    resetSettingsState();
                } else {
                    // 用户取消离开，保持在当前页面
                    return;
                }
            }

            // 检查当前是否在摄像头页面，如果是且摄像头正在运行，则自动停止
            const currentCameraSection = document.getElementById('camera-content');
            if (currentCameraSection && currentCameraSection.style.display !== 'none' && sectionId !== 'camera') {
                // 检查摄像头是否正在运行
                if (rtspPlayer || currentStream) {
                    console.log('离开摄像头页面，自动停止摄像头');
                    stopCamera();
                }
            }
            
            // 移除所有菜单项的active类
            document.querySelectorAll('.sidebar-menu a').forEach(link => {
                link.classList.remove('active');
            });
            
            // 为当前点击的菜单项添加active类
            if (element) {
                element.classList.add('active');
            } else {
                // 如果没有传递element参数，则根据sectionId查找对应的链接
                const targetLink = document.querySelector(`a[onclick*="showSection('${sectionId}')"]`);
                if (targetLink) {
                    targetLink.classList.add('active');
                }
            }
            
            // 隐藏所有内容区域
            document.querySelectorAll('.content-section').forEach(section => {
                section.style.display = 'none';
            });
            
            // 显示选中的内容区域
            const contentId = sectionId + '-content';
            const targetSection = document.getElementById(contentId);
            if (targetSection) {
                targetSection.style.display = 'block';
                
                // 当切换到进程监控页面时，立即加载进程信息
                if (sectionId === 'process-monitor') {
                    loadProcesses();
                }
                
                // 当切换到网络监控页面时，立即加载网络信息
                if (sectionId === 'network') {
                    loadNetworkInfo();
                    loadNetworkSettings();
                    loadGlobalNetworkConfig();
                    
                    // 启动网络接口状态自动刷新
                    startNetworkAutoRefresh();
                } else {
                    // 离开网络监控页面时停止自动刷新
                    stopNetworkAutoRefresh();
                }
                
                // 当切换到系统设置页面时，加载网络设置
                if (sectionId === 'settings') {
                    loadNetworkSettings();
                    initSettingsChangeDetection();
                }
                
                // 当切换到摄像头页面时，初始化摄像头功能
                if (sectionId === 'camera') {
                    initCamera();
                }
                
                // 当切换到文件管理页面时，初始化文件管理器
                if (sectionId === 'file-manager') {
                    // 确保DOM元素已加载，使用更可靠的检查机制
                    const checkAndInit = () => {
                        const fileListElement = document.getElementById('file-list');
                        if (fileListElement) {
                            console.log('文件管理器DOM元素已准备就绪，开始初始化');
                            initFileManager();
                        } else {
                            console.log('文件管理器DOM元素未准备就绪，等待中...');
                            setTimeout(checkAndInit, 50);
                        }
                    };
                    checkAndInit();
                }
                
                // 当切换到雷达监控页面时，初始化雷达功能
                if (sectionId === 'radar-monitor') {
                    initRadarMonitor();
                } else {
                    stopRadarAnimation();
                }
                
                // 更新页面标题
                updatePageTitle(sectionId);
            }
        }
        

        
        // 显示修改密码模态框
        function showPasswordModal() {
            const modal = new bootstrap.Modal(document.getElementById('passwordModal'));
            modal.show();
        }
        

        
        // 修改密码
        function changePassword() {
            const currentPassword = document.getElementById('current-password').value;
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-password').value;
            
            if (!currentPassword || !newPassword || !confirmPassword) {
                showErrorAlert('请填写所有密码字段');
                return;
            }
            
            if (newPassword !== confirmPassword) {
                showErrorAlert('新密码和确认密码不匹配');
                return;
            }
            
            if (newPassword.length < 6) {
                showErrorAlert('新密码长度至少6位');
                return;
            }
            
            // 发送修改密码请求
            fetch('/api/user/password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    currentPassword: currentPassword,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    showErrorAlert('修改密码失败: ' + data.error);
                } else {
                    showSuccessAlert('密码修改成功');
                    const modal = bootstrap.Modal.getInstance(document.getElementById('passwordModal'));
                    modal.hide();
                    
                    // 清空表单
                    document.getElementById('current-password').value = '';
                    document.getElementById('new-password').value = '';
                    document.getElementById('confirm-password').value = '';
                }
            })
            .catch(error => {
                console.error('修改密码失败:', error);
                showErrorAlert('修改密码失败');
            });
        }
        
        // 更新顶部导航栏标题
        function updatePageTitle(sectionId) {
            const titles = {
                'dashboard': '仪表板',
                'system-info': '系统信息',
                'radar-monitor': '雷达监控',
                'process-monitor': '进程监控',
                'file-manager': '文件管理',
                'network': '网络管理',
                'logs': '系统日志',
                'settings': '系统设置'
            };
            
            document.querySelector('.navbar-brand').textContent = titles[sectionId] || '仪表板';
            
            // 在移动端自动隐藏侧边栏
            if (window.innerWidth <= 768) {
                document.getElementById('sidebar').classList.remove('show');
            }
        }




        // 初始化资源使用图表
        function initResourceChart() {
            const ctx = document.getElementById('resourceChart').getContext('2d');
            

            
            resourceChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['CPU使用率', 'CPU空闲', '物理内存使用', '内存空闲'],
                    datasets: [{
                        data: [
                            systemData.cpuUsage,
                            100 - systemData.cpuUsage,
                            systemData.memoryUsage,
                            100 - systemData.memoryUsage
                        ],
                        backgroundColor: [
                            '#667eea',
                            '#f093fb',
                            '#28a745',
                            '#ffeaa7',
                            '#fd79a8',
                            '#6c5ce7',
                            '#a29bfe',
                            '#fd79a8'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%', // 增加中心空白区域以显示文字
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            enabled: true
                        }
                    }
                },
                plugins: []
            });
        }

        // 添加更新动画效果
        function addUpdateAnimation(elementId) {
            const element = document.getElementById(elementId);
            if (element) {
                element.classList.add('stat-value-updating');
                setTimeout(() => {
                    element.classList.remove('stat-value-updating');
                }, 500);
            }
        }
        
        // 更新圆形进度条
        function updateCircularProgress(elementId, percentage) {
            const progressBar = document.getElementById(elementId + 'ProgressBar');
            if (progressBar) {
                const circumference = 2 * Math.PI * 45; // r=45
                const offset = circumference - (percentage / 100) * circumference;
                progressBar.style.strokeDashoffset = offset;
                progressBar.style.transition = 'stroke-dashoffset 0.8s ease-in-out';
            }
        }

        // 定时更新系统信息
        function updateSystemInfo() {
            // 检查系统信息相关DOM元素是否存在，如果不存在说明页面已切换
            const cpuElement = document.getElementById('cpuUsage');
            if (!cpuElement || !document.contains(cpuElement)) {
                console.log('系统信息页面已切换，停止更新');
                return;
            }
            
            fetch('/api/system-info')
                .then(response => {
                    if (response.status === 401) {
                        // 会话已过期，重定向到登录页面
                        window.location.href = '/login';
                        return;
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data) return; // 如果已重定向，data为undefined
                    
                    // 更新CPU使用率 - 添加安全检查
                    if (data.cpu && typeof data.cpu.usage !== 'undefined') {
                        const cpuElement = document.getElementById('cpuUsage');
                        if (cpuElement && cpuElement.textContent !== data.cpu.usage + '%') {
                            cpuElement.textContent = data.cpu.usage + '%';
                            updateCircularProgress('cpu', data.cpu.usage);
                            addUpdateAnimation('cpuUsage');
                        }
                    }
                    
                    // 更新内存监控 - 添加安全检查
                    if (data.memory && typeof data.memory.usage !== 'undefined' && 
                        typeof data.memory.used !== 'undefined' && typeof data.memory.total !== 'undefined') {
                        const memoryElement = document.getElementById('memoryUsage');
                        const memoryDetailsElement = document.getElementById('memoryDetails');
                        const newMemoryValue = data.memory.usage + '%';
                        const newMemoryDetails = (data.memory.used / 1024).toFixed(1) + '/' + (data.memory.total / 1024).toFixed(1) + 'GB';
                        
                        if (memoryElement && memoryElement.textContent !== newMemoryValue) {
                            memoryElement.textContent = newMemoryValue;
                            updateCircularProgress('memory', data.memory.usage);
                            addUpdateAnimation('memoryUsage');
                        }
                        
                        if (memoryDetailsElement && memoryDetailsElement.textContent !== newMemoryDetails) {
                            memoryDetailsElement.textContent = newMemoryDetails;
                        }
                        // 同步内存总/使用到卡片brief
                        const memoryTotalBriefEl = document.getElementById('memoryTotalBrief');
                        const memoryUsedBriefEl = document.getElementById('memoryUsedBrief');
                        const memTotalGB = (data.memory.total / 1024);
                        const memUsedGB = (data.memory.used / 1024);
                        const newMemTotalText = memTotalGB.toFixed(2);
                        const newMemUsedText = memUsedGB.toFixed(2);
                        if (memoryTotalBriefEl && memoryTotalBriefEl.textContent !== newMemTotalText) {
                            memoryTotalBriefEl.textContent = newMemTotalText;
                            addUpdateAnimation('memoryTotalBrief');
                        }
                        if (memoryUsedBriefEl && memoryUsedBriefEl.textContent !== newMemUsedText) {
                            memoryUsedBriefEl.textContent = newMemUsedText;
                            addUpdateAnimation('memoryUsedBrief');
                        }
                    }
                    
                    // 更新磁盘使用率（第一个磁盘） - 添加安全检查
                    if (data.disk && data.disk.length > 0 && data.disk[0]) {
                        const diskElement = document.getElementById('diskUsage');
                        const diskUsagePct = (typeof data.disk[0].usage !== 'undefined') ? data.disk[0].usage : data.disk[0].usePercent;
                        if (typeof diskUsagePct !== 'undefined') {
                            const newDiskValue = diskUsagePct + '%';
                            if (diskElement && diskElement.textContent !== newDiskValue) {
                                diskElement.textContent = newDiskValue;
                                updateCircularProgress('disk', diskUsagePct);
                                addUpdateAnimation('diskUsage');
                            }
                        }
                    }
                    
                    // 更新磁盘总容量与剩余空间（聚合 + 单位自适配）
                    if (data.disk && data.disk.length > 0) {
                        const sumRawSize = data.disk.reduce((sum, d) => sum + (d.size || 0), 0);
                        const sumRawAvail = data.disk.reduce((sum, d) => sum + (d.available || 0), 0);
                        const isBytesApi = sumRawSize > 100000; // 大于阈值则视为字节，需转换
                        const totalSizeGB = isBytesApi ? (sumRawSize / 1024 / 1024 / 1024) : sumRawSize;
                        const totalAvailableGB = isBytesApi ? (sumRawAvail / 1024 / 1024 / 1024) : sumRawAvail;
                        const totalEl = document.getElementById('diskTotalCapacity');
                        const freeEl = document.getElementById('diskFreeSpace');
                        const newTotalText = totalSizeGB.toFixed(2);
                        const newFreeText = totalAvailableGB.toFixed(2);
                        if (totalEl && totalEl.textContent !== newTotalText) {
                            totalEl.textContent = newTotalText;
                            addUpdateAnimation('diskTotalCapacity');
                        }
                        if (freeEl && freeEl.textContent !== newFreeText) {
                            freeEl.textContent = newFreeText;
                            addUpdateAnimation('diskFreeSpace');
                        }
                        const totalBriefEl = document.getElementById('diskTotalCapacityBrief');
                        const freeBriefEl = document.getElementById('diskFreeSpaceBrief');
                        if (totalBriefEl && totalBriefEl.textContent !== newTotalText) {
                            totalBriefEl.textContent = newTotalText;
                            addUpdateAnimation('diskTotalCapacityBrief');
                        }
                        if (freeBriefEl && freeBriefEl.textContent !== newFreeText) {
                            freeBriefEl.textContent = newFreeText;
                            addUpdateAnimation('diskFreeSpaceBrief');
                        }
                    }
                    
                    // 更新运行时间（运行时间显示为时:分格式，转换为百分比用于进度条显示）
                    if (data.uptime) {
                        const uptimeElement = document.getElementById('systemUptime');
                        if (uptimeElement && uptimeElement.textContent !== data.uptime) {
                            uptimeElement.textContent = data.uptime;
                            // 解析时:分格式，计算24小时周期的百分比
                            const timeParts = data.uptime.split(':');
                            if (timeParts.length === 2) {
                                const hours = parseInt(timeParts[0]);
                                const minutes = parseInt(timeParts[1]);
                                const totalMinutes = (hours % 24) * 60 + minutes;
                                const uptimePercentage = totalMinutes / (24 * 60) * 100;
                                updateCircularProgress('uptime', uptimePercentage);
                            }
                            addUpdateAnimation('systemUptime');
                        }
                    }
                    
                    // 更新全局数据 - 添加安全检查
                    if (data.cpu && typeof data.cpu.usage !== 'undefined') {
                        systemData.cpuUsage = data.cpu.usage;
                    }
                    if (data.memory && typeof data.memory.usage !== 'undefined') {
                        systemData.memoryUsage = data.memory.usage;
                        // 检查内存阈值
                        checkMemoryThreshold(data.memory.usage);
                    }
                    
                    // 更新图表（确保图表已初始化） - 添加安全检查
                    if (resourceChart && resourceChart.data && resourceChart.data.datasets[0] &&
                        data.cpu && typeof data.cpu.usage !== 'undefined' &&
                        data.memory && typeof data.memory.usage !== 'undefined') {
                        resourceChart.data.datasets[0].data = [
                            data.cpu.usage,
                            100 - data.cpu.usage,
                            data.memory.usage,
                            100 - data.memory.usage
                        ];
                        resourceChart.update();
                    }
                })
                .catch(error => {
                    console.error('更新系统信息失败:', error);
                    // 显示错误信息到页面上
                    const errorElement = document.getElementById('systemInfoError');
                    if (errorElement) {
                        errorElement.textContent = '系统信息加载失败: ' + error.message;
                        errorElement.style.display = 'block';
                    }
                });
        }

        // 内存优化函数
        async function optimizeMemory() {
            try {
                console.log('开始自动内存优化...');
                
                const response = await fetch('/api/memory/optimize', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                const result = await response.json();
                const msg = result && (result.message || result.error) ? (result.message || result.error) : '未知错误';
                
                if (result && result.success) {
                    console.log('内存优化完成: ' + msg);
                    // 立即更新系统信息
                    updateSystemInfo();
                    beautifulAlert(msg, '内存优化', 'success');
                } else {
                    console.error('内存优化失败: ' + msg);
                    beautifulAlert('内存优化失败: ' + msg, '内存优化', 'error');
                }
            } catch (error) {
                const msg = (error && (error.message || String(error))) || '未知错误';
                console.error('内存优化失败: ' + msg);
                beautifulAlert('内存优化失败: ' + msg, '内存优化', 'error');
            }
        }

        // 自动内存优化检查
        let memoryThreshold = 80; // 默认阈值80%
        let autoOptimizeEnabled = true;
        
        function checkMemoryThreshold(memoryUsage) {
            if (autoOptimizeEnabled && memoryUsage > memoryThreshold) {
                // 自动进行内存优化
                console.log(`内存使用率 ${memoryUsage.toFixed(1)}% 超过阈值 ${memoryThreshold}%，正在自动优化...`);
                optimizeMemory();
                
                // 显示自动优化通知
                beautifulAlert(
                    `检测到内存使用率过高 (${memoryUsage.toFixed(1)}%)，已自动进行内存优化。`,
                    '自动内存优化',
                    'info'
                );
            }
        }

