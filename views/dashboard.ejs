            color: #303133;
        }

        .file-table tbody tr:hover {
            background-color: #f5f7fa;
        }
        
        .file-table tbody tr.selected {
            background-color: #e6f7ff;
        }
        
        .file-table tbody tr.selected:hover {
            background-color: #bae7ff;
        }

        .select-column {
            text-align: center;
        }

        .permissions-column {
            text-align: center;
            font-family: monospace;
            font-size: 13px;
        }
        
        .owner-column {
            text-align: center;
            font-size: 13px;
        }
        
        .group-column {
            text-align: center;
            font-size: 13px;
        }
        
        .action-column {
            text-align: center;
        }

        .loading-state {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #909399;
            font-size: 14px;
            padding: 40px 0;
        }
        
        .file-icon {
            width: 20px;
            height: 20px;
            margin-right: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        
        .file-icon.folder {
            color: #1890ff;
        }
        
        .file-icon.file {
            color: #606266;
        }
        
        .file-icon.image {
            color: #52c41a;
        }
        
        .file-icon.video {
            color: #fa8c16;
        }
        
        .file-icon.archive {
            color: #722ed1;
        }
        
        .file-name {
            display: flex;
            align-items: center;
            font-weight: 500;
        }
        
        .file-name:hover {
            color: #1890ff;
            cursor: pointer;
        }
        
        .file-size {
            color: #909399;
            font-size: 13px;
        }
        
        .file-date {
            color: #909399;
            font-size: 13px;
        }
        
        .file-actions {
            display: flex;
            gap: 4px;
            justify-content: center;
        }
        
        .file-actions .btn {
            padding: 4px 8px;
            font-size: 12px;
            border-radius: 4px;
        }
        
        /* 文字型操作按钮样式 */
        .file-actions.text-actions {
            display: flex;
            flex-direction: row;
            gap: 0;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }
        
        .file-actions.text-actions .btn-link {
            padding: 2px 6px;
            font-size: 12px;
            text-decoration: none;
            border: none;
            background: none;
            font-weight: 500;
            position: relative;
        }
        
        .file-actions.text-actions .btn-link:not(:last-child):after {
            content: '|';
            color: #dee2e6;
            margin-left: 6px;
            font-weight: normal;
        }
        
        .file-actions.text-actions .dropdown:not(:last-child):after {
            content: '|';
            color: #dee2e6;
            margin-left: 6px;
            font-weight: normal;
        }
        
        .file-actions.text-actions .btn-link:hover {
            text-decoration: underline;
            opacity: 0.8;
        }
        
        .file-actions.text-actions .dropdown-toggle::after {
            font-size: 10px;
            margin-left: 4px;
        }
        
        .file-actions.text-actions .dropdown-menu {
            font-size: 12px;
            min-width: 120px;
        }
        
        .file-actions.text-actions .dropdown-item {
            padding: 6px 12px;
            font-size: 12px;
        }
        
        .file-actions.text-actions .dropdown-item:hover {
            background-color: #f8f9fa;
        }

        /* 响应式设计 */
        @media (max-width: 768px) {
            .file-toolbar {
                flex-direction: column;
                gap: 12px;
                align-items: stretch;
            }
            
            .search-box {
                width: 100%;
            }
            
            /* 移动设备上确保下拉菜单不被遮挡 */
            .file-actions .dropdown-menu {
                position: fixed !important;
                z-index: 1060 !important;
            }
            
            /* 移动设备上的表格容器也要设置overflow为visible */
            .table-responsive {
                overflow: visible !important;
            }
        }
        
        /* 美化弹窗样式 */
        .beautiful-modal .modal-content {
            border: none;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
        }
        
        .beautiful-modal .modal-header {
            padding: 2rem 2rem 1rem;
            border: none;
            position: relative;
        }
        
        .beautiful-modal .modal-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: inherit;
            opacity: 0.9;
        }
        
        .beautiful-modal .modal-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
        }
        
        .beautiful-modal .modal-body {
            padding: 1rem 2rem;
        }
        
        .beautiful-modal .modal-footer {
            padding: 1rem 2rem 2rem;
            border: none;
        }
        
        .beautiful-modal .btn {
            border: none;
            padding: 12px 30px;
            font-weight: 500;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }
        
        .beautiful-modal .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }
        
        /* 成功弹窗样式 */
        .alert-success .modal-header {
            background: linear-gradient(135deg, #28a745, #20c997) !important;
        }
        
        .alert-error .modal-header {
            background: linear-gradient(135deg, #dc3545, #e83e8c) !important;
        }
        
        .alert-warning .modal-header {
            background: linear-gradient(135deg, #ffc107, #fd7e14) !important;
        }
        
        .alert-info .modal-header {
            background: linear-gradient(135deg, #17a2b8, #6f42c1) !important;
        }
        
        /* 确保modal背景保持默认 */
        .beautiful-modal .modal-content {
            background: #fff !important;
        }
        
        .beautiful-modal .modal-body {
            background: transparent !important;
        }
        
        .beautiful-modal .modal-footer {
            background: transparent !important;
        }
        
        /* 确保modal backdrop完全透明 */
        .modal-backdrop {
            background-color: transparent !important;
            background-image: none !important;
        }
        
        /* 确保页面背景不受modal类影响 */
        body.modal-open {
            background: inherit !important;
        }
        
        /* 防止alert-success类影响页面背景 */
        body,
        body.modal-open,
        html,
        html.modal-open {
            background: #f8f9fa !important;
            background-color: #f8f9fa !important;
            background-image: none !important;
        }
        
        /* 确保弹窗容器不影响页面背景 */
        .modal.alert-success,
        .modal.alert-error,
        .modal.alert-warning,
        .modal.alert-info {
            background: transparent !important;
        }
        
        /* 弹窗尺寸优化 */
        .beautiful-modal .modal-dialog {
            max-width: 400px;
            width: 90%;
        }
        
        @media (min-width: 576px) {
            .beautiful-modal .modal-dialog {
                width: 400px;
            }
        }
        
        /* 弹窗动画 */
        .modal.fade .modal-dialog {
            transform: scale(0.8) translateY(-50px);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        
        .modal.show .modal-dialog {
            transform: scale(1) translateY(0);
        }
        
        /* 输入框美化 */
        .beautiful-modal .form-control {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 16px;
            transition: all 0.3s ease;
        }
        
        .beautiful-modal .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            transform: translateY(-1px);
        }
        
        /* 脉冲动画 */
        @keyframes modalPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        
        .modal-pulse {
            animation: modalPulse 0.6s ease-in-out;
        }
        
        /* 图标旋转动画 */
        @keyframes iconSpin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        .icon-spin {
            animation: iconSpin 1s linear infinite;
        }
        
        /* 网络接口状态样式 */
        .interface-option-up {
            background-color: #d4edda !important;
            color: #155724 !important;
            border-left: 4px solid #28a745 !important;
        }
        
        .interface-option-down {
            background-color: #f8d7da !important;
            color: #721c24 !important;
            border-left: 4px solid #dc3545 !important;
        }
        
        .interface-status-badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: bold;
            margin-left: 8px;
        }
        
        .interface-status-up {
            background-color: #28a745;
            color: white;
        }
        
        .interface-status-down {
            background-color: #dc3545;
            color: white;
        }
    </style>
    <!-- RTSP Relay 客户端脚本 -->
    <script id="rtsp-relay-script"></script>
</head>
<body>
