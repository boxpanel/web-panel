        // 为下载对话框加载文件夹树（从根目录开始）
        function loadFoldersForDownload() {
            const folderTree = document.getElementById('downloadFolderTree');
            
            // 从根目录开始加载
            fetch('/api/files/folders', {
            credentials: 'same-origin'
        })
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.folders) {
                        folderTree.innerHTML = renderFolderTree(data.folders, 'download');
                    } else {
                        folderTree.innerHTML = '<div class="text-center py-3 text-danger">加载文件夹失败</div>';
                    }
                })
                .catch(error => {
                    console.error('加载文件夹失败:', error);
                    folderTree.innerHTML = '<div class="text-center py-3 text-danger">加载文件夹失败</div>';
                });
