        // 现代化的输入对话框函数
        function showInputDialog(title, prompt, defaultValue = '') {
            return new Promise((resolve) => {
                const modal = new bootstrap.Modal(document.getElementById('inputModal'));
                const titleElement = document.getElementById('inputModalLabel');
                const promptElement = document.getElementById('inputModalPrompt');
                const inputElement = document.getElementById('inputModalInput');
                const confirmButton = document.getElementById('inputModalConfirm');
                
                titleElement.textContent = title;
                promptElement.textContent = prompt;
                inputElement.value = defaultValue;
                inputElement.placeholder = defaultValue;
                
                // 清除之前的事件监听器
                const newConfirmButton = confirmButton.cloneNode(true);
                confirmButton.parentNode.replaceChild(newConfirmButton, confirmButton);
                
                // 添加确定按钮事件
                newConfirmButton.addEventListener('click', () => {
                    const value = inputElement.value.trim();
                    modal.hide();
                    resolve(value || null);
                });
                
                // 添加取消事件
                document.getElementById('inputModal').addEventListener('hidden.bs.modal', () => {
                    resolve(null);
                }, { once: true });
                
                // 添加回车键支持
                inputElement.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        newConfirmButton.click();
                    }
                });
                
                modal.show();
                setTimeout(() => inputElement.focus(), 500);
            });
        }
        
