        // 全选/取消全选
        function toggleSelectAll() {
            const selectAllCheckbox = document.getElementById('select-all');
            const checkboxes = document.querySelectorAll('#file-list input[type="checkbox"]');
            
            checkboxes.forEach(cb => {
                cb.checked = selectAllCheckbox.checked;
            });
            
            updateBatchOperations();
        }
        
        // 更新选中文件数量和批量操作显示
        function updateBatchOperations() {
            const checkedBoxes = document.querySelectorAll('#file-list input[type="checkbox"]:checked');
            const selectedFiles = Array.from(checkedBoxes).map(cb => cb.value);
            const hasSelection = selectedFiles.length > 0;
            const batchOperations = document.getElementById('batch-operations');
            const selectedCount = document.getElementById('selected-count');
            
            // 控制头部按钮的启用/禁用状态
            const deleteBtn = document.getElementById('batch-delete-btn');
            const compressBtn = document.getElementById('batch-compress-btn');
            const permissionsBtn = document.getElementById('batch-permissions-btn');
            const copyBtn = document.getElementById('batch-copy-btn');
            const moveBtn = document.getElementById('batch-move-btn');
            const pasteBtn = document.getElementById('batch-paste-btn');
            
            if (hasSelection) {
                if (batchOperations) {
                    batchOperations.style.display = 'block';
                    selectedCount.textContent = selectedFiles.length;
                }
                
                // 启用头部按钮
                if (deleteBtn) deleteBtn.disabled = false;
                if (compressBtn) compressBtn.disabled = false;
                if (permissionsBtn) permissionsBtn.disabled = false;
                if (copyBtn) copyBtn.disabled = false;
                if (moveBtn) moveBtn.disabled = false;
            } else {
                if (batchOperations) batchOperations.style.display = 'none';
                
                // 禁用头部按钮
                if (deleteBtn) deleteBtn.disabled = true;
                if (compressBtn) compressBtn.disabled = true;
                if (permissionsBtn) permissionsBtn.disabled = true;
                if (copyBtn) copyBtn.disabled = true;
                if (moveBtn) moveBtn.disabled = true;
            }
            
            // 粘贴按钮的状态取决于剪贴板是否有内容
            if (pasteBtn) {
                pasteBtn.disabled = !clipboard || !clipboard.files || clipboard.files.length === 0;
            }
        }
        
        // 监听文件选择变化
        document.addEventListener('change', function(e) {
            if (e.target.type === 'checkbox' && e.target.closest('#file-list')) {
                updateBatchOperations();
            }
        });
        
        // 加载全局网络配置
        function loadGlobalNetworkConfig() {
            fetch('/api/network-config')
                .then(response => {
                    if (response.status === 401) {
                        window.location.href = '/login';
                        return;
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data) return;
                    
                    // 将全局配置存储到全局变量
                    window.globalNetworkConfig = data;
                    
                    // 如果有保存的配置，应用到相应的表单元素
                    if (data.ipMode) {
                        const ipModeRadio = document.querySelector(`input[name="ip-mode"][value="${data.ipMode}"]`);
                        if (ipModeRadio) {
                            ipModeRadio.checked = true;
                        }
                    }
                    
                    // 应用静态IP设置
                    if (data.ipMode === 'static') {
                        const staticIPInput = document.getElementById('static-ip');
                        const subnetMaskSelect = document.getElementById('subnet-mask');
                        const gatewayInput = document.getElementById('gateway');
                        
                        if (staticIPInput && data.staticIP) staticIPInput.value = data.staticIP;
                        if (subnetMaskSelect && data.subnetMask) subnetMaskSelect.value = data.subnetMask;
                        if (gatewayInput && data.gateway) gatewayInput.value = data.gateway;
                    }
                    
                    // 应用DNS设置
                    if (data.primaryDNS) {
                        const primaryDNSInput = document.getElementById('primary-dns');
                        if (primaryDNSInput) primaryDNSInput.value = data.primaryDNS;
                    }
                    if (data.secondaryDNS) {
                        const secondaryDNSInput = document.getElementById('secondary-dns');
                        if (secondaryDNSInput) secondaryDNSInput.value = data.secondaryDNS;
                    }
                })
                .catch(error => {
                    console.error('加载全局网络配置失败:', error);
                });
        }
        
        // 加载网络信息
        function loadNetworkInfo() {
            fetch('/api/network-interfaces')
                .then(response => {
                    if (response.status === 401) {
                        // 会话已过期，重定向到登录页面
                        window.location.href = '/login';
                        return;
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data) return; // 如果已重定向，data为undefined
                    
                    console.log('网络接口API响应:', data);
                    
                    // 更新网络接口卡片
                    const interfacesContainer = document.getElementById('network-interfaces-cards');
                    if (!interfacesContainer || !document.contains(interfacesContainer)) {
                        console.log('页面已切换，取消网络接口更新');
                        return;
                    }
                    
                    // 检查API响应是否有错误
                    if (data.error) {
                        console.error('API返回错误:', data.error);
                        interfacesContainer.innerHTML = `
                            <div class="text-center text-danger py-5">
                                <i class="bi bi-exclamation-triangle display-1 text-danger mb-3"></i>
                                <h6>获取网络接口失败</h6>
                                <p class="small">${data.error}</p>
                                <button class="btn btn-outline-primary btn-sm" onclick="loadNetworkInfo()">
                                    <i class="bi bi-arrow-clockwise me-1"></i>重新加载
                                </button>
                            </div>
