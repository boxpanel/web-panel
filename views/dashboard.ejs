                            <input class="form-check-input" type="checkbox" id="compressLevel" checked>
                            <label class="form-check-label" for="compressLevel">
                                高压缩率（较慢）
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="compressPassword">
                            <label class="form-check-label" for="compressPassword">
                                设置密码保护
                            </label>
                        </div>
                    </div>
                    <div class="password-input mt-2" id="passwordInput" style="display: none;">
                        <input type="password" class="form-control" id="compressPasswordValue" placeholder="请输入密码">
                    </div>
                </div>
            </div>
            <div class="compress-panel-footer">
                <button type="button" class="btn btn-secondary me-2" onclick="closeCompressPanel()">
                    <i class="bi bi-x me-1"></i>取消
                </button>
                <button type="button" class="btn btn-primary" onclick="startCompress()">
                    <i class="bi bi-file-zip me-1"></i>开始压缩
                </button>
            </div>
        </div>
    </div>

    <!-- 美化弹窗组件 -->
    <!-- 通用提示弹窗 -->
    <div class="modal fade" id="beautifulAlertModal" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
                <div class="modal-header border-0 text-white position-relative" id="alertModalHeader">
                    <div class="d-flex align-items-center w-100">
                        <div class="modal-icon me-3" id="alertModalIcon">
                            <i class="bi bi-check-circle-fill" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0" id="alertModalTitle">提示</h5>
                            <small class="opacity-75" id="alertModalSubtitle"></small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center">
                        <p class="mb-0 fs-6" id="alertModalMessage">这是一条提示消息</p>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-primary px-4 rounded-pill" data-bs-dismiss="modal" id="alertModalOkBtn">
                        <i class="bi bi-check me-2"></i>确定
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 确认弹窗 -->
    <div class="modal fade" id="beautifulConfirmModal" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
                <div class="modal-header border-0 bg-warning text-dark position-relative">
                    <div class="d-flex align-items-center w-100">
                        <div class="modal-icon me-3">
                            <i class="bi bi-question-circle-fill" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0" id="confirmModalTitle">确认操作</h5>
                            <small class="opacity-75">请确认您的操作</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center">
                        <p class="mb-0 fs-6" id="confirmModalMessage">您确定要执行此操作吗？</p>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-outline-secondary me-3 px-4 rounded-pill" data-bs-dismiss="modal">
                        <i class="bi bi-x me-2"></i>取消
                    </button>
                    <button type="button" class="btn btn-warning px-4 rounded-pill" id="confirmModalOkBtn">
                        <i class="bi bi-check me-2"></i>确定
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 输入弹窗 -->
    <div class="modal fade" id="beautifulPromptModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
                <div class="modal-header border-0 bg-info text-white position-relative">
                    <div class="d-flex align-items-center w-100">
                        <div class="modal-icon me-3">
                            <i class="bi bi-pencil-square" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0" id="promptModalTitle">输入信息</h5>
                            <small class="opacity-75">请输入相关信息</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label" id="promptModalLabel">请输入：</label>
                        <input type="text" class="form-control form-control-lg" id="promptModalInput" placeholder="请输入内容...">
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-outline-secondary me-3 px-4 rounded-pill" data-bs-dismiss="modal">
                        <i class="bi bi-x me-2"></i>取消
                    </button>
                    <button type="button" class="btn btn-info px-4 rounded-pill" id="promptModalOkBtn">
                        <i class="bi bi-check me-2"></i>确定
                    </button>
                </div>
            </div>
        </div>
    </div>



</body>
</html>
