        // IP地址验证函数
        function validateIPAddress(ip) {
            const ipRegex = /^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
            return ipRegex.test(ip);
        }
        
        // 验证IP地址是否在有效范围内
        function validateIPRange(ip) {
            const parts = ip.split('.');
            for (let part of parts) {
                const num = parseInt(part);
                if (num < 0 || num > 255) {
                    return false;
                }
            }
            // 检查是否为保留地址
            const firstOctet = parseInt(parts[0]);
            if (firstOctet === 0 || firstOctet === 127 || firstOctet >= 224) {
                return false;
            }
            return true;
        }
        
        // 验证子网掩码
        function validateSubnetMask(mask) {
            const validMasks = [
                '255.255.255.0', '255.255.0.0', '255.0.0.0',
                '255.255.255.128', '255.255.255.192', '255.255.255.224',
                '255.255.255.240', '255.255.255.248', '255.255.255.252'
            ];
            return validMasks.includes(mask) || validateIPAddress(mask);
        }
        
        // 验证网络配置的完整性
        function validateNetworkConfig(config) {
            const errors = [];
            
            if (config.ipMode === 'static') {
                if (!config.staticIP) {
                    errors.push('请输入静态IP地址');
                } else if (!validateIPAddress(config.staticIP)) {
                    errors.push('静态IP地址格式不正确');
                } else if (!validateIPRange(config.staticIP)) {
                    errors.push('静态IP地址不在有效范围内');
                }
                
                if (!config.subnetMask) {
                    errors.push('请选择子网掩码');
                } else if (!validateSubnetMask(config.subnetMask)) {
                    errors.push('子网掩码格式不正确');
                }
                
                if (!config.gateway) {
                    errors.push('请输入默认网关');
                } else if (!validateIPAddress(config.gateway)) {
                    errors.push('默认网关格式不正确');
                } else if (!validateIPRange(config.gateway)) {
                    errors.push('默认网关不在有效范围内');
                }
                
                // 检查IP和网关是否在同一网段
                if (config.staticIP && config.gateway && config.subnetMask) {
                    if (!isInSameSubnet(config.staticIP, config.gateway, config.subnetMask)) {
                        errors.push('静态IP地址和网关不在同一网段');
                    }
                }
            }
            
            // 验证DNS设置
            if (config.primaryDNS && !validateIPAddress(config.primaryDNS)) {
                errors.push('首选DNS服务器格式不正确');
            }
            if (config.secondaryDNS && !validateIPAddress(config.secondaryDNS)) {
                errors.push('备用DNS服务器格式不正确');
            }
            
            return errors;
        }
        
        // 检查两个IP是否在同一子网
        function isInSameSubnet(ip1, ip2, mask) {
            const ip1Parts = ip1.split('.').map(Number);
            const ip2Parts = ip2.split('.').map(Number);
            const maskParts = mask.split('.').map(Number);
            
            for (let i = 0; i < 4; i++) {
                if ((ip1Parts[i] & maskParts[i]) !== (ip2Parts[i] & maskParts[i])) {
                    return false;
                }
            }
            return true;
        }
        
        // 显示验证错误
        function showValidationErrors(errors, containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            
            if (errors.length > 0) {
                const errorHtml = `
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>配置错误：</strong>
                        <ul class="mb-0 mt-2">
                            ${errors.map(error => `<li>${error}</li>`).join('')}
                        </ul>
                    </div>
                `;
                container.innerHTML = errorHtml;
                container.style.display = 'block';
            } else {
                container.style.display = 'none';
            }
        }
        
