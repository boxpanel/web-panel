                    </div>
                `;
            }).join('');
        }
        
        // 切换文件夹展开/折叠状态
        function toggleFolderTree(toggleIcon, type) {
            const folderItem = toggleIcon.closest('.folder-item');
            const childrenContainer = folderItem.querySelector('.folder-children');
            const folderPath = folderItem.dataset.path;
            
            if (childrenContainer.style.display === 'none') {
                // 展开文件夹
                toggleIcon.classList.remove('bi-chevron-right');
                toggleIcon.classList.add('bi-chevron-down');
                
                // 如果还没有加载子文件夹，则加载
                if (childrenContainer.innerHTML.trim() === '') {
                    childrenContainer.innerHTML = '<div class="text-center py-2"><div class="spinner-border spinner-border-sm" role="status"></div></div>';
                    
                    fetch(`/api/files/folders?path=${encodeURIComponent(folderPath)}`, {
                credentials: 'same-origin'
            })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success && data.folders) {
                                if (data.folders.length === 0) {
                                    childrenContainer.innerHTML = '<div class="text-muted small py-1">无子文件夹</div>';
                                } else {
                                    childrenContainer.innerHTML = renderFolderTree(data.folders, type);
                                }
                            } else {
                                childrenContainer.innerHTML = '<div class="text-danger small py-1">加载失败</div>';
                            }
                        })
                        .catch(error => {
                            console.error('加载子文件夹失败:', error);
                            childrenContainer.innerHTML = '<div class="text-danger small py-1">加载失败</div>';
                        });
                }
                
                childrenContainer.style.display = 'block';
            } else {
                // 折叠文件夹
                toggleIcon.classList.remove('bi-chevron-down');
                toggleIcon.classList.add('bi-chevron-right');
                childrenContainer.style.display = 'none';
            }
        }
        
        // 切换上传树文件夹展开/折叠状态（显示文件和文件夹）
        function toggleUploadTree(toggleIcon, type) {
            const folderItem = toggleIcon.closest('.folder-item');
            const childrenContainer = folderItem.querySelector('.folder-children');
            const folderPath = folderItem.dataset.path;
            
            if (childrenContainer.style.display === 'none') {
                // 展开文件夹
                toggleIcon.classList.remove('bi-chevron-right');
                toggleIcon.classList.add('bi-chevron-down');
                
                // 如果还没有加载子内容，则加载
                if (childrenContainer.innerHTML.trim() === '') {
                    childrenContainer.innerHTML = '<div class="text-center py-2"><div class="spinner-border spinner-border-sm" role="status"></div></div>';
                    
                    fetch(`/api/files/folders-and-files?path=${encodeURIComponent(folderPath)}`, {
                credentials: 'same-origin'
            })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success && data.items) {
                                if (data.items.length === 0) {
                                    childrenContainer.innerHTML = '<div class="text-muted small py-1">空文件夹</div>';
                                } else {
                                    childrenContainer.innerHTML = renderUploadTree(data.items, type);
                                }
                            } else {
                                childrenContainer.innerHTML = '<div class="text-danger small py-1">加载失败</div>';
                            }
                        })
                        .catch(error => {
                            console.error('加载文件夹内容失败:', error);
                            childrenContainer.innerHTML = '<div class="text-danger small py-1">加载失败</div>';
                        });
                }
                
                childrenContainer.style.display = 'block';
            } else {
                // 折叠文件夹
                toggleIcon.classList.remove('bi-chevron-down');
                toggleIcon.classList.add('bi-chevron-right');
                childrenContainer.style.display = 'none';
