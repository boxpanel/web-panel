        // 加载进程信息
        function loadProcesses() {
            // 检查进程列表相关DOM元素是否存在，如果不存在说明页面已切换
            const processList = document.getElementById('process-list');
            if (!processList || !document.contains(processList)) {
                console.log('进程信息页面已切换，停止更新');
                return;
            }
            
            fetch('/api/processes')
                .then(response => {
                    if (response.status === 401) {
                        // 会话已过期，重定向到登录页面
                        window.location.href = '/login';
                        return;
                    }
                    return response.json();
                })
                .then(data => {
                    if (!data) return; // 如果已重定向，data为undefined
                    
                    const processList = document.getElementById('process-list');
                    if (!processList) {
                        console.error('process-list元素未找到，无法显示进程信息');
                        return;
                    }
                    
                    if (data.error) {
                        // 重新检查DOM元素
                        const processListCheck = document.getElementById('process-list');
                        if (processListCheck && document.contains(processListCheck)) {
                            processListCheck.innerHTML = `<tr><td colspan="5" class="text-center text-danger">${data.error}</td></tr>`;
                        }
                        return;
                    }
                    
                    if (data.length === 0) {
                        // 重新检查DOM元素
                        const processListCheck = document.getElementById('process-list');
                        if (processListCheck && document.contains(processListCheck)) {
                            processListCheck.innerHTML = '<tr><td colspan="5" class="text-center text-muted">暂无进程信息</td></tr>';
                        }
                        return;
                    }
                    
                    // 重新检查DOM元素
                    const processListCheck = document.getElementById('process-list');
                    if (processListCheck && document.contains(processListCheck)) {
                        processListCheck.innerHTML = data.map(proc => `
                        <tr>
                            <td>${proc.pid}</td>
                            <td>${proc.name}</td>
                            <td>${proc.cpu}%</td>
                            <td>${proc.memory} MB</td>
                            <td><span class="badge bg-${proc.state === 'running' ? 'success' : 'secondary'}">${proc.state}</span></td>
                        </tr>
                    `).join('');
                    }
                })
                .catch(error => {
                    console.error('加载进程信息失败:', error);
                    const processList = document.getElementById('process-list');
                    if (!processList) {
                        console.error('process-list元素未找到，无法显示错误信息');
