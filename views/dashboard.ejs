                                                <button class="btn btn-outline-secondary btn-sm me-2" onclick="refreshCameraLogs()">
                                                    <i class="bi bi-arrow-clockwise"></i> 刷新
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm" onclick="clearCameraLogs()">
                                                    <i class="bi bi-trash"></i> 清空
                                                </button>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <div id="camera-logs" style="height: 200px; overflow-y: auto; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 5px; padding: 10px; font-family: 'Courier New', monospace; font-size: 12px;">
                                                <div class="text-muted text-center">暂无日志信息</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <h6 class="mb-0">摄像头设置</h6>
                                        </div>
                                        <div class="card-body">
                                            <!-- 网络摄像头设置 -->
                                            <div class="mb-3">
                                                <div class="row">
                                                    <div class="col-8">
                                                        <label class="form-label">摄像头IP地址</label>
                                                        <input type="text" class="form-control" id="camera-ip" placeholder="例如: 192.168.1.100">
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label">端口号</label>
                                                        <input type="number" class="form-control" id="camera-port" placeholder="554" value="554">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">用户名</label>
                                                <input type="text" class="form-control" id="camera-username" placeholder="摄像头登录用户名">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">密码</label>
                                                <input type="text" class="form-control" id="camera-password" placeholder="摄像头登录密码">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">RTSP流路径</label>
                                                <select class="form-select" id="rtsp-path-select" onchange="handleRtspPathChange()">
                                                    <option value="/stream1">通用路径: /stream1</option>
                                                    <option value="/stream2">通用路径: /stream2</option>
                                                    <option value="/cam/realmonitor?channel=1&subtype=0">大华摄像头: /cam/realmonitor?channel=1&subtype=0</option>
                                                    <option value="/cam/realmonitor?channel=1&subtype=1">大华摄像头(子码流): /cam/realmonitor?channel=1&subtype=1</option>
                                                    <option value="/Streaming/Channels/101">海康威视: /Streaming/Channels/101</option>
                                                    <option value="/Streaming/Channels/102">海康威视(子码流): /Streaming/Channels/102</option>
                                                    <option value="/live/ch1">通用路径: /live/ch1</option>
                                                    <option value="/h264/ch1/main/av_stream">通用路径: /h264/ch1/main/av_stream</option>
                                                    <option value="custom">自定义路径</option>
                                                </select>
                                                <input type="text" class="form-control mt-2" id="stream-url" placeholder="输入自定义RTSP路径或完整RTSP地址" style="display: none;">
                                                <small class="form-text text-muted">选择摄像头品牌对应的RTSP路径，或输入完整RTSP地址</small>
                                            </div>


                                            <!-- AI模型选择 -->
                                            <div class="mb-3">
                                                <label class="form-label">AI处理模型</label>
                                                <select id="model-select" class="form-select">
                                                    <option value="">无模型处理</option>
                                                </select>
                                                <small class="form-text text-muted">选择用于视频处理的AI模型</small>
                                            </div>
                                            <div class="mb-3">
                                                <button class="btn btn-outline-secondary btn-sm" id="refresh-models">
                                                    <i class="bi bi-arrow-clockwise"></i> 刷新模型列表
                                                </button>
                                            </div>
                                            

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 雷达监控内容 -->
        <div id="radar-monitor-content" class="content-section" style="display: none;">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header text-white" style="background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%);">
                            <h5 class="card-title mb-0" style="color: white;">
                                <i class="bi bi-broadcast me-2" style="color: white;"></i>
                                雷达监控
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- 左侧 3D 显示容器 -->
                                <div class="col-md-8">
                                    <div class="card">
                                        <div class="card-body">
                                            <div id="radar-3d-container" style="min-height: 400px; background: #0b132b; border-radius: 10px; position: relative; display: flex; align-items: center; justify-content: center;">
                                                <canvas id="radarCanvas" style="width: 100%; height: 100%;"></canvas>
                                                <div id="radar-3d-placeholder" class="text-muted" style="position: absolute;">
                                                    <i class="bi bi-broadcast" style="font-size: 3rem; color: #6c757d;"></i>
                                                </div>
                                                <!-- 车道宽度 HUD 指示器 -->
                                                <div id="lane-width-indicator" style="position: absolute; top: 10px; right: 10px; background: rgba(255,255,255,0.08); color: #ffffff; border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; padding: 4px 8px; font-size: 12px; letter-spacing: 0.2px; backdrop-filter: blur(2px);">
                                                    车道宽度: 6.0 m
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- 原始16进制数据 -->
                                    <div class="card mt-3">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h6 class="mb-0">原始16进制数据</h6>
