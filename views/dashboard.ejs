                             onmouseout="this.style.backgroundColor='transparent'">
                            ${hasChildren ? `<i class="bi bi-chevron-right toggle-icon me-1" onclick="toggleUploadTree(this, '${type}')"></i>` : '<span class="me-3"></span>'}
                            <i class="bi ${iconClass} ${iconColor} me-2"></i>
                            <span onclick="${isFolder ? 'selectUploadTreePath' : 'void(0)'}('${escapedItemPath}')" 
