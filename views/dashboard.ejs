                        initSettingsChangeDetection();
                    }, 100);
                } else {
                    showErrorAlert('保存网络设置失败: ' + (data.error || '未知错误'));
                }
            })
            .catch(error => {
                console.error('保存设置失败:', error);
                showErrorAlert('保存设置失败: ' + error.message);
            });
        }
        
