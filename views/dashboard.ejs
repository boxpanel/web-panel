        // 载入根目录函数
        function loadRootDirectory() {
            // 检测操作系统类型
            const isWindows = currentPath.includes('\\') || currentPath.match(/^[A-Z]:\\/);
            
            let rootPath;
            if (isWindows) {
                // Windows系统：提取当前路径的盘符作为根目录
                const driveMatch = currentPath.match(/^([A-Z]):\\/);
                rootPath = driveMatch ? driveMatch[1] + ':\\' : 'C:\\';
            } else {
                // Linux/Unix系统：根目录为 /
                rootPath = '/';
            }
            
            // 载入根目录
            loadDirectory(rootPath);
        }
        
        function isValidPath(path) {
            // 基本路径验证
            if (!path || path.length === 0) return false;
            
            // Windows路径验证
            if (path.match(/^[A-Za-z]:\\/)) {
                return !path.match(/[<>:"|?*]/);
            }
            
            // Unix/Linux路径验证
            if (path.startsWith('/')) {
                return !path.includes('\0');
            }
            
            // 相对路径也允许
            return true;
        }
        
