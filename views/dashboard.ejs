        // 渲染文件夹树结构
        function renderFolderTree(folders, type) {
            return folders.map(folder => {
                const isExpanded = false;
                const hasChildren = folder.type === 'drive' || folder.type === 'folder';
                
                // 转义路径中的特殊字符
                const escapedPath = folder.path.replace(/\\/g, '\\\\').replace(/'/g, "\\'")
                
                return `
                    <div class="folder-item" data-path="${escapedPath}">
                        <div class="d-flex align-items-center py-1 folder-header" style="cursor: pointer; border-radius: 4px; padding-left: 0px;" 
                             onmouseover="this.style.backgroundColor='#f8f9fa'" 
                             onmouseout="this.style.backgroundColor='transparent'">
                            ${hasChildren ? `<i class="bi bi-chevron-right toggle-icon me-1" onclick="toggleFolderTree(this, '${type}')"></i>` : '<span class="me-3"></span>'}
                            <i class="bi ${folder.type === 'drive' ? 'bi-hdd' : 'bi-folder'} text-warning me-2"></i>
                            <span onclick="${type === 'upload' ? 'selectUploadTreePath' : 'selectTreePath'}('${escapedPath}')">${folder.name}</span>
                        </div>
                        <div class="folder-children" style="display: none; padding-left: 20px;"></div>
                    </div>
                `;
            }).join('');
        }
        
        // 渲染上传树结构（包含文件和文件夹）
        function renderUploadTree(items, type) {
            return items.map(item => {
                const isFolder = item.type === 'drive' || item.type === 'folder';
                const hasChildren = isFolder;
                const iconClass = item.type === 'drive' ? 'bi-hdd' : 
                                 item.type === 'folder' ? 'bi-folder' : 'bi-file-earmark';
                const iconColor = isFolder ? 'text-warning' : 'text-primary';
                const displayName = isFolder ? item.name : `${item.name} (${item.size})`;
                
                // 转义路径中的特殊字符
                const escapedItemPath = item.path.replace(/\\/g, '\\\\').replace(/'/g, "\\'")
                
                return `
                    <div class="folder-item" data-path="${escapedItemPath}" data-type="${item.type}">
                        <div class="d-flex align-items-center py-1 folder-header" style="cursor: pointer; border-radius: 4px; padding-left: 0px;" 
