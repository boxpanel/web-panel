        // 更新分页信息
        function updateLogsPagination(pagination) {
            const paginationEl = document.getElementById('logs-pagination');
            const { page, totalPages } = pagination;
            
            let paginationHTML = '';
            
            // 上一页
            if (page > 1) {
                paginationHTML += `<li class="page-item"><a class="page-link" href="#" onclick="loadLogs(${page - 1})">上一页</a></li>`;
            }
            
            // 页码
            const startPage = Math.max(1, page - 2);
            const endPage = Math.min(totalPages, page + 2);
            
            for (let i = startPage; i <= endPage; i++) {
                const activeClass = i === page ? 'active' : '';
                paginationHTML += `<li class="page-item ${activeClass}"><a class="page-link" href="#" onclick="loadLogs(${i})">${i}</a></li>`;
            }
            
            // 下一页
            if (page < totalPages) {
                paginationHTML += `<li class="page-item"><a class="page-link" href="#" onclick="loadLogs(${page + 1})">下一页</a></li>`;
            }
            
            paginationEl.innerHTML = paginationHTML;
        }
        
