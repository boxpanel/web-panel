        // 粘贴文件
        async function pasteFiles() {
            if (!clipboard || !clipboard.files || clipboard.files.length === 0) {
                // 按钮已被禁用，直接返回
                return;
            }
            
            const operation = clipboard.operation === 'copy' ? '复制' : '移动';
            const apiEndpoint = clipboard.operation === 'copy' ? '/api/files/copy' : '/api/files/move';
            
            try {
                // 调用后端API进行文件操作
                const response = await fetch(apiEndpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        files: clipboard.files,
                        sourcePath: clipboard.sourcePath,
                        targetPath: currentPath
                    })
                });
                
                const result = await response.json();
                
                if (response.ok && result.success) {
                    // 清空剪贴板并隐藏粘贴按钮
                    clipboard = { files: [], operation: null, sourcePath: null };
