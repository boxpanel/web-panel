                                </ul>
                            </div>
                        </div>
                    </td>
                `;
                
                fileList.appendChild(row);
            });
            
            // 更新文件数量显示
            updateFileCount(files.length);
        }
        
        // 导航到指定路径
        function navigateToPath(path) {
            loadDirectory(path, true);
        }
        
        // 打开文件夹
        function openFolder(folderName) {
            console.log('openFolder called with:', folderName, 'currentPath:', currentPath);
            
            // 检测当前系统的路径分隔符
            const isWindows = currentPath.includes('\\') || currentPath.match(/^[A-Z]:\\/);
            const separator = isWindows ? '\\' : '/';
            
            if (folderName === '..') {
                // 返回上级目录
                const pathParts = currentPath.split(/[\\\/]/).filter(part => part);
                pathParts.pop();
                if (pathParts.length === 0) {
                    // 根目录处理
                    currentPath = isWindows ? 'C:\\' : '/';
                } else if (pathParts.length === 1 && isWindows) {
                    currentPath = pathParts[0] + separator;
                } else {
                    currentPath = pathParts.join(separator);
                    if (isWindows || currentPath !== '/') {
                        currentPath += separator;
                    }
                }
            } else {
                // 构建新路径
                let newPath = currentPath;
                if (!newPath.endsWith(separator)) {
                    newPath += separator;
                }
                newPath += folderName;
                // 只有在Windows系统或非根目录时才添加尾部分隔符
                if (isWindows && !newPath.endsWith(separator)) {
                    newPath += separator;
                }
                currentPath = newPath;
            }
            
            console.log('New currentPath:', currentPath);
            
            // 更新路径输入框的值
            const pathInput = document.getElementById('current-path-input');
            if (pathInput) {
                pathInput.value = currentPath;
            }
            
            loadDirectory(currentPath, true);
        }
        
        // 返回上一级目录
        function goUp() {
            try {
                console.log('GoUp - Current path:', currentPath);
                
                // 检测当前系统的路径分隔符
                const isWindows = currentPath.includes('\\') || currentPath.match(/^[A-Z]:\\/i);
                const separator = isWindows ? '\\' : '/';
                
                // 标准化路径分隔符
                let normalizedPath = currentPath.replace(/[\\\/]+/g, separator);
                
                // 移除末尾的分隔符（除非是根目录）
                if (normalizedPath.length > 1 && normalizedPath.endsWith(separator)) {
                    normalizedPath = normalizedPath.slice(0, -1);
                }
                
                // 分割路径
                const pathParts = normalizedPath.split(separator).filter(part => part);
                
                // 移除最后一个部分（当前目录）
                pathParts.pop();
                
                let newPath;
                if (pathParts.length === 0) {
                    // 根目录处理
                    newPath = isWindows ? 'C:\\' : '/';
                } else if (pathParts.length === 1 && isWindows && pathParts[0].match(/^[A-Z]:$/i)) {
                    // Windows驱动器根目录
                    newPath = pathParts[0] + separator;
                } else {
                    // 构建新路径
                    newPath = pathParts.join(separator);
                    if (isWindows) {
                        newPath += separator;
                    } else if (newPath !== '/') {
                        newPath = '/' + newPath;
                    }
                }
                
                console.log('GoUp - New path:', newPath);
                currentPath = newPath;
                
                // 更新路径输入框的值
                const pathInput = document.getElementById('current-path-input');
                if (pathInput) {
                    pathInput.value = currentPath;
                }
                
                loadDirectory(currentPath, true);
            } catch (error) {
                console.error('GoUp function error:', error);
                beautifulAlert('返回上一级目录失败: ' + error.message, 'error', '错误');
            }
        }
        
        // 后退操作（实际执行前进功能）
        function goBack() {
            if (historyIndex < navigationHistory.length - 1) {
                historyIndex++;
                const nextPath = navigationHistory[historyIndex];
                currentPath = nextPath;
                console.log('GoBack (Forward) - New currentPath:', currentPath);
                
                // 更新路径输入框的值
                const pathInput = document.getElementById('current-path-input');
                if (pathInput) {
                    pathInput.value = currentPath;
                }
                
                loadDirectory(currentPath, false); // false表示不记录到历史
                updateNavigationButtons();
            }
        }
        
        // 前进操作
        function goForward() {
            if (historyIndex < navigationHistory.length - 1) {
                historyIndex++;
                const nextPath = navigationHistory[historyIndex];
                currentPath = nextPath;
                console.log('GoForward - New currentPath:', currentPath);
                
                // 更新路径输入框的值
                const pathInput = document.getElementById('current-path-input');
                if (pathInput) {
                    pathInput.value = currentPath;
                }
                
                loadDirectory(currentPath, false); // false表示不记录到历史
                updateNavigationButtons();
            }
        }
        
        // 更新导航按钮状态
        function updateNavigationButtons() {
            const backBtn = document.getElementById('backBtn');
            const forwardBtn = document.getElementById('forwardBtn');
            
            if (backBtn) {
                backBtn.disabled = historyIndex <= 0;
            }
            if (forwardBtn) {
                forwardBtn.disabled = historyIndex >= navigationHistory.length - 1;
            }
        }
        
        // 添加路径到历史记录
        function addToHistory(path) {
            // 如果当前不在历史记录的末尾，删除后面的记录
            if (historyIndex < navigationHistory.length - 1) {
                navigationHistory = navigationHistory.slice(0, historyIndex + 1);
            }
            
            // 如果新路径与当前路径不同，添加到历史记录
            if (navigationHistory.length === 0 || navigationHistory[navigationHistory.length - 1] !== path) {
                navigationHistory.push(path);
                historyIndex = navigationHistory.length - 1;
            }
            
            updateNavigationButtons();
        }
        
