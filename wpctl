#!/bin/bash

# Web Panel Control Tool - 基于1Panel的wpctl设计
# 类似1Panel的1pctl命令行工具

set -e

# 配置
APP_NAME="web-panel"
INSTALL_DIR="/opt/web-panel"
SERVICE_NAME="web-panel"
CONFIG_FILE="$INSTALL_DIR/backend/config/app.yaml"
LOG_FILE="/opt/web-panel/logs/web-panel.log"
PID_FILE="/var/run/web-panel.pid"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 显示帮助信息
show_help() {
    cat << EOF
Web Panel Control Tool (wpctl) - 类似1Panel的管理工具

用法: wpctl [命令] [选项]

命令:
  start           启动 Web Panel 服务
  stop            停止 Web Panel 服务
  restart         重启 Web Panel 服务
  status          查看服务状态
  logs            查看日志
  version         显示版本信息
  update          更新 Web Panel
  backup          备份数据
  restore         恢复数据
  reset           重置管理员密码
  uninstall       卸载 Web Panel
  
选项:
  -h, --help      显示帮助信息
  -v, --version   显示版本信息
  -f, --follow    实时跟踪日志（与logs命令配合使用）
  
示例:
  wpctl start                    # 启动服务
  wpctl logs -f                  # 实时查看日志
  wpctl backup /path/to/backup   # 备份到指定路径
  wpctl reset admin              # 重置admin用户密码

EOF
}

# 检查服务状态
check_service_status() {
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        return 0  # 运行中
    else
        return 1  # 未运行
    fi
}

# 启动服务
start_service() {
    print_info "启动 Web Panel 服务..."
    
    if check_service_status; then
        print_warning "Web Panel 服务已在运行中"
        return
    fi
    
    systemctl start "$SERVICE_NAME"
    sleep 2
    
    if check_service_status; then
        print_success "Web Panel 服务启动成功"
        print_info "访问地址: http://localhost:8080"
    else
        print_error "Web Panel 服务启动失败"
        print_info "请查看日志: wpctl logs"
        exit 1
    fi
}

# 停止服务
stop_service() {
    print_info "停止 Web Panel 服务..."
    
    if ! check_service_status; then
        print_warning "Web Panel 服务未运行"
        return
    fi
    
    systemctl stop "$SERVICE_NAME"
    sleep 2
    
    if ! check_service_status; then
        print_success "Web Panel 服务已停止"
    else
        print_error "Web Panel 服务停止失败"
        exit 1
    fi
}

# 重启服务
restart_service() {
    print_info "重启 Web Panel 服务..."
    stop_service
    start_service
}

# 查看服务状态
show_status() {
    print_info "Web Panel 服务状态:"
    systemctl status "$SERVICE_NAME" --no-pager
}

# 查看日志
show_logs() {
    local follow_flag="$1"
    
    if [ "$follow_flag" = "-f" ] || [ "$follow_flag" = "--follow" ]; then
        print_info "实时查看 Web Panel 日志 (Ctrl+C 退出):"
        tail -f "$LOG_FILE"
    else
        print_info "Web Panel 最近日志:"
        tail -n 50 "$LOG_FILE"
    fi
}

# 显示版本信息
show_version() {
    if [ -f "$INSTALL_DIR/version" ]; then
        local version=$(cat "$INSTALL_DIR/version")
        echo "Web Panel 版本: $version"
    else
        echo "Web Panel 版本: 未知"
    fi
    echo "wpctl 版本: 1.0.0"
}

# 备份数据
backup_data() {
    local backup_path="$1"
    
    if [ -z "$backup_path" ]; then
        backup_path="/opt/web-panel/backup/backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    fi
    
    print_info "备份 Web Panel 数据到: $backup_path"
    
    mkdir -p "$(dirname "$backup_path")"
    
    tar -czf "$backup_path" -C "$INSTALL_DIR" \
        backend/config \
        data \
        logs \
        uploads 2>/dev/null || true
    
    if [ -f "$backup_path" ]; then
        print_success "备份完成: $backup_path"
    else
        print_error "备份失败"
        exit 1
    fi
}

# 重置管理员密码
reset_password() {
    local username="${1:-admin}"
    
    print_info "重置用户 '$username' 的密码..."
    
    # 生成随机密码
    local new_password=$(openssl rand -base64 12)
    
    # 这里应该调用实际的密码重置逻辑
    # 暂时只是示例
    print_success "用户 '$username' 密码已重置"
    print_info "新密码: $new_password"
    print_warning "请立即登录并修改密码"
}

# 卸载服务
uninstall_service() {
    print_warning "即将卸载 Web Panel，此操作不可逆！"
    read -p "确认卸载？(y/N): " confirm
    
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
        print_info "取消卸载"
        return
    fi
    
    print_info "停止服务..."
    systemctl stop "$SERVICE_NAME" 2>/dev/null || true
    systemctl disable "$SERVICE_NAME" 2>/dev/null || true
    
    print_info "删除服务文件..."
    rm -f "/etc/systemd/system/$SERVICE_NAME.service"
    systemctl daemon-reload
    
    print_info "删除安装目录..."
    rm -rf "$INSTALL_DIR"
    
    print_success "Web Panel 卸载完成"
}

# 主函数
main() {
    case "$1" in
        start)
            start_service
            ;;
        stop)
            stop_service
            ;;
        restart)
            restart_service
            ;;
        status)
            show_status
            ;;
        logs)
            show_logs "$2"
            ;;
        version|-v|--version)
            show_version
            ;;
        backup)
            backup_data "$2"
            ;;
        reset)
            reset_password "$2"
            ;;
        uninstall)
            uninstall_service
            ;;
        help|-h|--help)
            show_help
            ;;
        "")
            show_help
            ;;
        *)
            print_error "未知命令: $1"
            print_info "使用 'wpctl help' 查看帮助信息"
            exit 1
            ;;
    esac
}

# 检查是否为root用户（某些操作需要）
if [ "$1" = "start" ] || [ "$1" = "stop" ] || [ "$1" = "restart" ] || [ "$1" = "uninstall" ]; then
    if [ "$EUID" -ne 0 ]; then
        print_error "此操作需要root权限"
        print_info "请使用: sudo wpctl $*"
        exit 1
    fi
fi

# 执行主函数
main "$@"